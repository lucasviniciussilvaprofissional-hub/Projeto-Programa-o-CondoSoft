<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="cadastrarVeiculoRoot"
            prefHeight="750.0" prefWidth="1200.0"
            style="-fx-background-color: #F7F8FA;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.condominio.controller.unidade.CadastrarVeiculoController">

    <!-- ═══════════════════════ HEADER ═══════════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="68.0"
              style="-fx-background-color: #1E293B; -fx-padding: 0 48 0 48;">
            <VBox alignment="CENTER_LEFT" spacing="2.0">
                <Label text="CondoSoft"
                       style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                <Label text="Cadastrar Veículo"
                       style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnVoltarVeiculos" text="← Veículos"
                    onAction="#voltarVeiculos"
                    style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-font-size: 13;
                           -fx-cursor: hand; -fx-border-color: #334155; -fx-border-radius: 8;
                           -fx-background-radius: 8; -fx-padding: 8 20;"/>
        </HBox>
    </top>

    <!-- ═══════════════════════ CONTEÚDO ═══════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: #F7F8FA; -fx-background-color: #F7F8FA; -fx-border-color: transparent;">
            <VBox spacing="28.0" style="-fx-background-color: #F7F8FA; -fx-padding: 40 60 40 60;">

                <!-- Breadcrumb -->
                <HBox spacing="6.0" alignment="CENTER_LEFT">
                    <Label text="Início" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-cursor: hand;" onMouseClicked="#voltarHome"/>
                    <Label text="›" style="-fx-font-size: 12; -fx-text-fill: #94A3B8;"/>
                    <Label text="Unidades" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-cursor: hand;" onMouseClicked="#voltarUnidades"/>
                    <Label text="›" style="-fx-font-size: 12; -fx-text-fill: #94A3B8;"/>
                    <Label text="Detalhes" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-cursor: hand;" onMouseClicked="#voltarDetalhes"/>
                    <Label text="›" style="-fx-font-size: 12; -fx-text-fill: #94A3B8;"/>
                    <Label text="Veículos" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-cursor: hand;" onMouseClicked="#voltarVeiculos"/>
                    <Label text="›" style="-fx-font-size: 12; -fx-text-fill: #94A3B8;"/>
                    <Label text="Cadastrar" style="-fx-font-size: 12; -fx-text-fill: #1E293B;"/>
                </HBox>

                <VBox spacing="6.0">
                    <Label text="Novo Veículo"
                           style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                    <HBox spacing="6.0" alignment="CENTER_LEFT">
                        <Label text="Unidade:" style="-fx-font-size: 13; -fx-text-fill: #64748B;"/>
                        <Label fx:id="lblUnidadeContexto" text="Apto 101 – Bloco A"
                               style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #2563EB;"/>
                    </HBox>
                </VBox>

                <Separator/>

                <!-- Card formulário centralizado -->
                <HBox alignment="CENTER">
                    <VBox spacing="28.0" prefWidth="680.0"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #E2E8F0;
                                 -fx-border-radius: 16; -fx-border-width: 1; -fx-padding: 44;
                                 -fx-effect: dropshadow(gaussian, #00000010, 12, 0, 0, 2);">

                        <!-- Ícone decorativo -->
                        <HBox alignment="CENTER_LEFT" spacing="16.0">
                            <VBox alignment="CENTER" prefWidth="64.0" prefHeight="64.0" maxWidth="64.0"
                                  style="-fx-background-color: #FFFBEB; -fx-background-radius: 16;">
                                <Label text="🚗" style="-fx-font-size: 30;"/>
                            </VBox>
                            <VBox spacing="4.0">
                                <Label text="Dados do Veículo"
                                       style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                                <Label text="Preencha as informações do veículo a ser cadastrado"
                                       style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
                            </VBox>
                        </HBox>

                        <Separator/>

                        <!-- Campos: modelo, placa, cor -->
                        <GridPane hgap="24.0" vgap="20.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="60.0"/>
                                <ColumnConstraints percentWidth="40.0"/>
                            </columnConstraints>

                            <!-- Modelo -->
                            <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="6.0">
                                <Label text="Modelo *"
                                       style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                                <TextField fx:id="txtModelo"
                                           promptText="Ex: Toyota Corolla, Honda Civic..."
                                           style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8;
                                                  -fx-background-radius: 8; -fx-padding: 12 14; -fx-font-size: 13;"/>
                                <Label text="Marca e modelo do veículo"
                                       style="-fx-font-size: 11; -fx-text-fill: #94A3B8;"/>
                            </VBox>

                            <!-- Placa -->
                            <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="6.0">
                                <Label text="Placa *"
                                       style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                                <TextField fx:id="txtPlaca"
                                           promptText="ABC-1234 ou ABC1D23"
                                           style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8;
                                                  -fx-background-radius: 8; -fx-padding: 12 14; -fx-font-size: 13;"/>
                                <Label text="Formato padrão ou Mercosul"
                                       style="-fx-font-size: 11; -fx-text-fill: #94A3B8;"/>
                            </VBox>

                            <!-- Cor -->
                            <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" spacing="6.0">
                                <Label text="Cor *"
                                       style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                                <TextField fx:id="txtCor"
                                           promptText="Ex: Preto, Branco, Prata..."
                                           style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8;
                                                  -fx-background-radius: 8; -fx-padding: 12 14; -fx-font-size: 13;"/>
                            </VBox>

                            <!-- Unidade (readonly) -->
                            <VBox GridPane.columnIndex="1" GridPane.rowIndex="1" spacing="6.0">
                                <Label text="Unidade"
                                       style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                                <TextField fx:id="txtUnidade" editable="false"
                                           style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8;
                                                  -fx-background-radius: 8; -fx-padding: 12 14; -fx-font-size: 13;
                                                  -fx-text-fill: #64748B;"/>
                                <Label text="Preenchido automaticamente"
                                       style="-fx-font-size: 11; -fx-text-fill: #94A3B8;"/>
                            </VBox>
                        </GridPane>

                        <!-- Preview visual da placa -->
                        <VBox spacing="8.0">
                            <Label text="PRÉ-VISUALIZAÇÃO"
                                   style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                            <HBox alignment="CENTER_LEFT" spacing="16.0"
                                  style="-fx-background-color: #F8FAFC; -fx-background-radius: 10;
                                         -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-border-width: 1; -fx-padding: 16 20;">
                                <Label text="🚗" style="-fx-font-size: 22;"/>
                                <VBox spacing="3.0">
                                    <Label fx:id="previewModelo" text="Modelo não preenchido"
                                           style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                                    <HBox spacing="12.0">
                                        <Label fx:id="previewPlaca" text="—"
                                               style="-fx-font-size: 12; -fx-text-fill: #64748B;
                                                      -fx-background-color: #E2E8F0; -fx-background-radius: 4; -fx-padding: 2 8;"/>
                                        <Label fx:id="previewCor" text="—"
                                               style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
                                    </HBox>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Nota -->
                        <Label text="* Campos obrigatórios"
                               style="-fx-font-size: 11; -fx-text-fill: #94A3B8;"/>

                        <!-- Botões -->
                        <HBox spacing="12.0" alignment="CENTER_RIGHT">
                            <Button fx:id="btnLimpar" text="Limpar"
                                    onAction="#limparFormulario"
                                    style="-fx-background-color: #F1F5F9; -fx-text-fill: #475569; -fx-background-radius: 8;
                                           -fx-padding: 12 28; -fx-font-size: 13; -fx-cursor: hand;
                                           -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-border-width: 1;"/>
                            <Button fx:id="btnSalvarVeiculo" text="Salvar Veículo"
                                    onAction="#salvarVeiculo"
                                    style="-fx-background-color: #D97706; -fx-text-fill: white; -fx-background-radius: 8;
                                           -fx-padding: 12 32; -fx-font-size: 13; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        </HBox>

                    </VBox>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
