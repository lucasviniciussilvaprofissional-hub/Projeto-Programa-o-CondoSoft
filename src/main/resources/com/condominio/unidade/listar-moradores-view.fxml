<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="listarMoradoresRoot" prefHeight="750.0" prefWidth="1200.0" style="-fx-background-color: #F7F8FA;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.condominio.controller.unidade.ListarMoradoresController">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="68.0" style="-fx-background-color: #1E293B; -fx-padding: 0 48 0 48;">

            <VBox alignment="CENTER_LEFT" spacing="2.0">
                <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #94A3B8;" text="CondoSoft" />

                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;" text="Moradores do Condomínio" />
                </HBox>
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER_RIGHT" spacing="12.0">

                <Button fx:id="btnNovoMorador" onAction="#abrirCadastrarMorador" style="-fx-background-color: #2563EB;                                -fx-text-fill: white;                                -fx-font-size: 13;                                -fx-font-weight: bold;                                -fx-cursor: hand;                                -fx-background-radius: 8;                                -fx-padding: 8 20;" text="+ Novo Morador" />

                <Button fx:id="btnVoltarDetalhes" onAction="#voltarDetalhesUnidade" style="-fx-background-color: transparent;                                -fx-text-fill: #94A3B8;                                -fx-font-size: 13;                                -fx-cursor: hand;                                -fx-border-color: #334155;                                -fx-border-radius: 8;                                -fx-background-radius: 8;                                -fx-padding: 8 20;" text="← Detalhes" />
            </HBox>
        </HBox>
    </top>

    <!-- CONTEÚDO -->
    <center>
        <VBox spacing="0.0" style="-fx-background-color: #F7F8FA;                      -fx-padding: 40 60 40 60;">

            <!-- Breadcrumb -->
            <HBox alignment="CENTER_LEFT" spacing="6.0" style="-fx-padding: 0 0 24 0;">

                <Label onMouseClicked="#voltarHome" text="Início" />

                <Label text="&gt;" />

                <Label text="Moradores" />
            </HBox>

            <!-- Título -->
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 24 0;">

                <VBox spacing="4.0">
                    <Label style="-fx-font-size: 22;                                   -fx-font-weight: bold;                                   -fx-text-fill: #1E293B;" text="Moradores Cadastrados" />

                    <Label fx:id="lblTotalMoradores" style="-fx-font-size: 13;                                   -fx-text-fill: #64748B;" text="0 moradores encontrados" />
                </VBox>
            </HBox>

            <!-- CARD -->
            <VBox spacing="0.0" style="-fx-background-color: white;                          -fx-background-radius: 16;                          -fx-border-color: #E2E8F0;                          -fx-border-radius: 16;                          -fx-border-width: 1;                          -fx-effect: dropshadow(gaussian, #00000010, 12, 0, 0, 2);" VBox.vgrow="ALWAYS">

                <!-- FILTROS -->
                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 20 24 20 24;                              -fx-border-color: transparent transparent #F1F5F9 transparent;                              -fx-border-width: 1;">

                    <!-- Busca -->
                    <HBox alignment="CENTER_LEFT" prefHeight="40.0" prefWidth="340.0" spacing="8.0" style="-fx-background-color: #F8FAFC;                                   -fx-border-color: #E2E8F0;                                   -fx-border-radius: 8;                                   -fx-background-radius: 8;                                   -fx-border-width: 1;                                   -fx-padding: 0 14;">

                        <Label style="-fx-font-size: 13;" text="🔍" />

                        <TextField fx:id="txtBusca" onKeyReleased="#filtrarMoradores" prefWidth="280.0" promptText="Buscar por nome ou CPF..." style="-fx-background-color: transparent;                                           -fx-border-color: transparent;                                           -fx-font-size: 13;" />
                    </HBox>

                    <Region HBox.hgrow="ALWAYS" />

                    <Button onAction="#limparFiltros" style="-fx-background-color: transparent;                                    -fx-text-fill: #64748B;                                    -fx-font-size: 12;                                    -fx-cursor: hand;" text="Limpar Filtros" />
                </HBox>

                <!-- TABELA -->
                <TableView fx:id="tabelaMoradores" prefHeight="460.0" style="-fx-background-color: transparent;                                   -fx-border-color: transparent;                                   -fx-font-size: 13;" VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="colNome" prefWidth="220.0" text="Nome" />

                        <TableColumn fx:id="colCpf" prefWidth="140.0" text="CPF" />

                        <TableColumn fx:id="colTelefone" prefWidth="140.0" text="Telefone" />

                        <TableColumn fx:id="colEmail" prefWidth="240.0" text="Email" />

                        <TableColumn fx:id="colTipo" prefWidth="130.0" text="Tipo" />

                        <TableColumn fx:id="colStatus" prefWidth="110.0" text="Status" />

                        <TableColumn fx:id="colAcoes" prefWidth="180.0" text="Ações" />
                    </columns>

                    <placeholder>
                        <VBox alignment="CENTER" spacing="12.0">

                            <Label style="-fx-font-size: 36;" text="👤" />

                            <Label style="-fx-font-size: 14;                                           -fx-font-weight: bold;                                           -fx-text-fill: #94A3B8;" text="Nenhum morador encontrado" />

                            <Label style="-fx-font-size: 12;                                           -fx-text-fill: #CBD5E1;" text="Cadastre o primeiro morador" />
                        </VBox>
                    </placeholder>
                </TableView>

                <!-- AÇÕES -->
                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 16 24 16 24;                              -fx-border-color: #F1F5F9 transparent transparent transparent;                              -fx-border-width: 1;                              -fx-background-color: #FAFBFC;">

                    <Button onAction="#abrirDetalhesMorador" style="-fx-background-color: #2563EB;                                    -fx-text-fill: white;                                    -fx-background-radius: 8;                                    -fx-padding: 9 20;                                    -fx-font-size: 12;                                    -fx-font-weight: bold;                                    -fx-cursor: hand;" text="👁 Ver Detalhes" />

                    <Button onAction="#removerMorador" style="-fx-background-color: #FEF2F2;                                    -fx-text-fill: #DC2626;                                    -fx-background-radius: 8;                                    -fx-padding: 9 20;                                    -fx-font-size: 12;                                    -fx-cursor: hand;                                    -fx-border-color: #FECACA;                                    -fx-border-radius: 8;" text="🗑 Remover" />

                    <Region HBox.hgrow="ALWAYS" />

                    <Label fx:id="lblSelecaoInfo" style="-fx-font-size: 12;                                   -fx-text-fill: #94A3B8;" text="Selecione um morador para gerenciá-lo" />
                </HBox>

            </VBox>

        </VBox>
    </center>

</BorderPane>
