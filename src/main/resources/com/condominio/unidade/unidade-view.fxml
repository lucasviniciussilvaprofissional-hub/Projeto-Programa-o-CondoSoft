<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        fx:id="unidadeRoot"
        prefHeight="750.0"
        prefWidth="1200.0"
        style="-fx-background-color: #F7F8FA;"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.condominio.controller.unidade.UnidadeController">

    <!-- HEADER -->
    <top>
        <HBox
                alignment="CENTER_LEFT"
                prefHeight="68.0"
                style="-fx-background-color: #1E293B; -fx-padding: 0 48 0 48;">

            <VBox alignment="CENTER_LEFT" spacing="2.0">
                <Label text="CondoSoft"
                       style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>

                <Label text="Gerenciar Unidades"
                       style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button
                    fx:id="btnVoltarHome"
                    text="← Início"
                    onAction="#voltarHome"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #94A3B8;
                           -fx-font-size: 13;
                           -fx-cursor: hand;
                           -fx-border-color: #334155;
                           -fx-border-radius: 8;
                           -fx-background-radius: 8;
                           -fx-padding: 8 20;"/>
        </HBox>
    </top>

    <!-- CONTEÚDO -->
    <center>
        <ScrollPane
                fitToWidth="true"
                style="-fx-background: #F7F8FA;
                       -fx-background-color: #F7F8FA;
                       -fx-border-color: transparent;">

            <VBox spacing="32.0"
                  style="-fx-background-color: #F7F8FA;
                         -fx-padding: 48 60 48 60;">

                <!-- Breadcrumb -->
                <HBox spacing="6.0" alignment="CENTER_LEFT">

                    <Label text="Início"
                           style="-fx-font-size: 12;
                                  -fx-text-fill: #2563EB;
                                  -fx-cursor: hand;"/>

                    <Label text=">"
                           style="-fx-font-size: 12;
                                  -fx-text-fill: #94A3B8;"/>

                    <Label text="Unidades"
                           style="-fx-font-size: 12;
                                  -fx-text-fill: #1E293B;"/>
                </HBox>

                <!-- Título -->
                <VBox spacing="6.0">

                    <Label text="Gerenciar Unidades"
                           style="-fx-font-size: 26;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #1E293B;"/>

                    <Label
                            text="Cadastre, liste e visualize detalhes das unidades do condomínio"
                            style="-fx-font-size: 13;
                                   -fx-text-fill: #64748B;"/>
                </VBox>

                <Separator/>

                <Label text="AÇÕES DISPONÍVEIS"
                       style="-fx-font-size: 10;
                              -fx-font-weight: bold;
                              -fx-text-fill: #94A3B8;"/>

                <!-- Cards -->
                <GridPane hgap="24.0" vgap="24.0">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.33"/>
                        <ColumnConstraints percentWidth="33.33"/>
                        <ColumnConstraints percentWidth="33.33"/>
                    </columnConstraints>

                    <rowConstraints>
                        <RowConstraints minHeight="240.0"/>
                    </rowConstraints>

                    <!-- CADASTRAR -->
                    <VBox
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="0"
                            spacing="16.0"
                            style="-fx-background-color: white;
                                   -fx-background-radius: 16;
                                   -fx-border-color: #E2E8F0;
                                   -fx-border-radius: 16;
                                   -fx-border-width: 1;
                                   -fx-padding: 32;
                                   -fx-effect: dropshadow(gaussian, #00000010, 12, 0, 0, 2);">

                        <VBox
                                alignment="CENTER"
                                prefWidth="56.0"
                                prefHeight="56.0"
                                maxWidth="56.0"
                                style="-fx-background-color: #EFF6FF;
                                       -fx-background-radius: 14;">

                            <Label text="+"
                                   style="-fx-font-size: 24;"/>
                        </VBox>

                        <VBox spacing="8.0">

                            <Label text="Cadastrar Unidade"
                                   style="-fx-font-size: 17;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #1E293B;"/>

                            <Label
                                    text="Adicione uma nova unidade ao sistema informando número, bloco e tipo."
                                    wrapText="true"
                                    style="-fx-font-size: 12;
                                           -fx-text-fill: #64748B;"/>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS"/>

                        <Button
                                fx:id="btnIrCadastrarUnidade"
                                text="Cadastrar Unidade"
                                onAction="#abrirCadastrarUnidade"
                                maxWidth="Infinity"
                                style="-fx-background-color: #2563EB;
                                       -fx-text-fill: white;
                                       -fx-background-radius: 10;
                                       -fx-padding: 12 24;
                                       -fx-font-size: 13;
                                       -fx-font-weight: bold;
                                       -fx-cursor: hand;"/>
                    </VBox>

                    <!-- LISTAR -->
                    <VBox
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="0"
                            spacing="16.0"
                            style="-fx-background-color: white;
                                   -fx-background-radius: 16;
                                   -fx-border-color: #E2E8F0;
                                   -fx-border-radius: 16;
                                   -fx-border-width: 1;
                                   -fx-padding: 32;
                                   -fx-effect: dropshadow(gaussian, #00000010, 12, 0, 0, 2);">

                        <VBox
                                alignment="CENTER"
                                prefWidth="56.0"
                                prefHeight="56.0"
                                maxWidth="56.0"
                                style="-fx-background-color: #F0FDF4;
                                       -fx-background-radius: 14;">

                            <Label text="≡"
                                   style="-fx-font-size: 24;"/>
                        </VBox>

                        <VBox spacing="8.0">

                            <Label text="Listar Unidades"
                                   style="-fx-font-size: 17;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #1E293B;"/>

                            <Label
                                    text="Visualize todas as unidades cadastradas e acesse seus detalhes."
                                    wrapText="true"
                                    style="-fx-font-size: 12;
                                           -fx-text-fill: #64748B;"/>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS"/>

                        <Button
                                fx:id="btnIrListarUnidades"
                                text="Ver Listagem"
                                onAction="#abrirListarUnidades"
                                maxWidth="Infinity"
                                style="-fx-background-color: #059669;
                                       -fx-text-fill: white;
                                       -fx-background-radius: 10;
                                       -fx-padding: 12 24;
                                       -fx-font-size: 13;
                                       -fx-font-weight: bold;
                                       -fx-cursor: hand;"/>
                    </VBox>

                    <!-- DETALHES -->
                    <VBox
                            GridPane.columnIndex="2"
                            GridPane.rowIndex="0"
                            spacing="16.0"
                            style="-fx-background-color: white;
                                   -fx-background-radius: 16;
                                   -fx-border-color: #E2E8F0;
                                   -fx-border-radius: 16;
                                   -fx-border-width: 1;
                                   -fx-padding: 32;
                                   -fx-effect: dropshadow(gaussian, #00000010, 12, 0, 0, 2);">

                        <VBox
                                alignment="CENTER"
                                prefWidth="56.0"
                                prefHeight="56.0"
                                maxWidth="56.0"
                                style="-fx-background-color: #FFF7ED;
                                       -fx-background-radius: 14;">

                            <Label text="i"
                                   style="-fx-font-size: 24;"/>
                        </VBox>

                        <VBox spacing="8.0">

                            <Label text="Detalhes da Unidade"
                                   style="-fx-font-size: 17;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #1E293B;"/>

                            <Label
                                    text="Acesse moradores, veículos e pets de uma unidade específica."
                                    wrapText="true"
                                    style="-fx-font-size: 12;
                                           -fx-text-fill: #64748B;"/>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS"/>

                        <HBox
                                alignment="CENTER_LEFT"
                                spacing="8.0"
                                style="-fx-background-color: #F8FAFC;
                                       -fx-background-radius: 8;
                                       -fx-border-color: #E2E8F0;
                                       -fx-border-radius: 8;
                                       -fx-border-width: 1;
                                       -fx-padding: 10 16;">

                            <Label text="ℹ"
                                   style="-fx-font-size: 13;"/>

                            <Label
                                    text="Disponível pela listagem de unidades"
                                    wrapText="true"
                                    style="-fx-font-size: 11;
                                           -fx-text-fill: #64748B;"/>
                        </HBox>
                    </VBox>

                </GridPane>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>