<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="cadastrarUnidadeRoot" prefHeight="750.0" prefWidth="1200.0" style="-fx-background-color: #F7F8FA;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.condominio.controller.unidade.CadastrarUnidadeController">

    <!-- ══════════════════════════════════════════════════════
         HEADER
    ══════════════════════════════════════════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="68.0" style="-fx-background-color: #1E293B; -fx-padding: 0 48 0 48;">
            <VBox alignment="CENTER_LEFT" spacing="2.0">
                <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #94A3B8;" text="CondoSoft" />
                <Label style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;" text="Cadastrar Unidade" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" spacing="12.0">
                <Button fx:id="btnVoltarUnidades" onAction="#voltarUnidades" style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-font-size: 13; -fx-cursor: hand; -fx-border-color: #334155; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 20;" text="← Unidades" />
                <Button fx:id="btnVoltarHome" onAction="#voltarHome" style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-size: 13; -fx-cursor: hand; -fx-padding: 8 20;" text="Início" />
            </HBox>
        </HBox>
    </top>

    <!-- ══════════════════════════════════════════════════════
         CONTEÚDO PRINCIPAL
    ══════════════════════════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: #F7F8FA; -fx-background-color: #F7F8FA; -fx-border-color: transparent;">

            <VBox spacing="28.0" style="-fx-background-color: #F7F8FA; -fx-padding: 48 60 48 60;">

                <!-- Breadcrumb -->
                <HBox alignment="CENTER_LEFT" spacing="6.0">
                    <Label onMouseClicked="#voltarHome" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-cursor: hand;" text="Início" />
                    <Label style="-fx-font-size: 12; -fx-text-fill: #94A3B8;" text="›" />
                    <Label onMouseClicked="#voltarUnidadesBreadcrumbs" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-cursor: hand;" text="Unidades" />
                    <Label style="-fx-font-size: 12; -fx-text-fill: #94A3B8;" text="›" />
                    <Label style="-fx-font-size: 12; -fx-text-fill: #1E293B;" text="Cadastrar" />
                </HBox>


                <!-- Título -->
                <VBox spacing="6.0">
                    <Label style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Nova Unidade" />
                    <Label style="-fx-font-size: 13; -fx-text-fill: #64748B;" text="Preencha os campos abaixo para cadastrar uma nova unidade no sistema" />
                </VBox>

                <Separator />

                <!-- ── Card do Formulário ── -->
                <VBox spacing="28.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #E2E8F0; -fx-border-radius: 16; -fx-border-width: 1; -fx-padding: 40; -fx-effect: dropshadow(gaussian, #00000010, 12, 0, 0, 2);">

                    <!-- Seção: Identificação -->
                    <VBox spacing="6.0">
                        <Label style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94A3B8;" text="IDENTIFICAÇÃO" />
                        <Separator />
                    </VBox>

                    <GridPane hgap="24.0" vgap="20.0">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="25.0" />
                            <ColumnConstraints percentWidth="25.0" />
                            <ColumnConstraints percentWidth="25.0" />
                            <ColumnConstraints percentWidth="25.0" />
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints maxHeight="70.0" minHeight="56.0" prefHeight="67.0" />
                            <RowConstraints maxHeight="72.0" minHeight="58.0" prefHeight="61.0" />
                        </rowConstraints>

                        <!-- Número da Unidade -->
                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Número da Unidade *" />
                            <TextField fx:id="txtNumeroUnidade" promptText="Ex: 101" style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14; -fx-font-size: 13; -fx-text-fill: #1E293B;" />
                        </VBox>

                        <!-- Bloco -->
                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Bloco *" />
                            <TextField fx:id="txtBloco" promptText="Ex: A" style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14; -fx-font-size: 13; -fx-text-fill: #1E293B;" />
                        </VBox>

                        <!-- Tipo -->
                        <VBox spacing="6.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                     <children>
                               <Label style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Capacidade (pessoas)" />
                               <TextField fx:id="txtCapacidade" promptText="Ex: 4" style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14; -fx-font-size: 13; -fx-text-fill: #1E293B;" />
                     </children>
                        </VBox>

                        <!-- Capacidade -->
                        <VBox spacing="6.0" GridPane.columnIndex="3" GridPane.rowIndex="0">
                            <Label style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Tipo *" />
                            <ComboBox fx:id="cmbTipo" maxWidth="Infinity" promptText="Selecione..." style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 4 8; -fx-font-size: 13;" />
                        </VBox>

                        <!-- Andar -->
                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                     <children>
                                <Label style="-fx-font-size: 12;                             -fx-font-weight: bold;                             -fx-text-fill: #374151;" text="Fração Ideal (%)" />
                               <TextField fx:id="txtFracaoIdeal" promptText="Ex: 1.25" style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14; -fx-font-size: 13; -fx-text-fill: #1E293B;" />
                     </children>
                        </VBox>

                        <!-- Área (m²) -->
                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Área (m²)" />
                            <TextField fx:id="txtArea" promptText="Ex: 75.50" style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14; -fx-font-size: 13; -fx-text-fill: #1E293B;" />
                        </VBox>

                        <!-- Status -->
                        <VBox spacing="6.0" GridPane.columnIndex="2" GridPane.rowIndex="1">
                            <Label style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Status" />
                            <ComboBox fx:id="cmbStatus" maxWidth="Infinity" promptText="Selecione..." style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 4 8; -fx-font-size: 13;" />
                        </VBox>

                        <!-- Fração Ideal -->
                        <VBox spacing="6.0" GridPane.columnIndex="3" GridPane.rowIndex="1">
                            <Label style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Situação Financeira" />

                            <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="2" />

                             <ComboBox fx:id="cmbSituacaoFinanceira" maxWidth="Infinity" prefHeight="20.0" prefWidth="227.0" promptText="Selecione..." style="-fx-background-color: white;                                  -fx-border-color: #CBD5E1;                                  -fx-border-radius: 8;                                  -fx-background-radius: 8;                                  -fx-padding: 4 8;                                  -fx-font-size: 13;" />
                        </VBox>


                    </GridPane>

                    <!-- Seção: Observações -->
                    <VBox spacing="6.0">
                        <Label style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94A3B8;" text="INFORMAÇÕES ADICIONAIS" />
                        <Separator />
                    </VBox>

                    <VBox spacing="6.0">
                        <Label style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;" text="Observações" />
                        <TextArea fx:id="txtObservacoes" prefHeight="90.0" promptText="Informações adicionais sobre a unidade..." style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14; -fx-font-size: 13; -fx-text-fill: #1E293B;" wrapText="true" />
                    </VBox>

                    <!-- Nota obrigatório -->
                    <Label style="-fx-font-size: 11; -fx-text-fill: #94A3B8;" text="* Campos obrigatórios" />

                    <!-- ── Botões de Ação ── -->
                    <HBox alignment="CENTER_RIGHT" spacing="12.0">
                        <Button fx:id="btnLimparFormulario" onAction="#limparFormulario" style="-fx-background-color: #F1F5F9; -fx-text-fill: #475569; -fx-background-radius: 8; -fx-padding: 12 28; -fx-font-size: 13; -fx-cursor: hand; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-border-width: 1;" text="Limpar" />
                        <Button fx:id="btnSalvarUnidade" onAction="#salvarUnidade" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12 32; -fx-font-size: 13; -fx-font-weight: bold; -fx-cursor: hand;" text="Salvar Unidade" />
                    </HBox>

                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
