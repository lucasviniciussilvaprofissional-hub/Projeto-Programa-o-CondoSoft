<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="gerenciarMoradoresRoot" prefHeight="750.0" prefWidth="1200.0" style="-fx-background-color: #F7F8FA;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.condominio.controller.unidade.GerenciarMoradoresUnidadeController">

    <!-- ═══════════════════════ HEADER ═══════════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="68.0" style="-fx-background-color: #1E293B; -fx-padding: 0 48 0 48;">
            <VBox alignment="CENTER_LEFT" spacing="2.0">
                <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #94A3B8;" text="CondoSoft" />
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;" text="Moradores da Unidade" />
                    <Label fx:id="lblBadgeUnidade" style="-fx-background-color: #334155; -fx-text-fill: #94A3B8;                                   -fx-background-radius: 6; -fx-padding: 4 12; -fx-font-size: 12;" text="Apto 101 – Bloco A" />
                </HBox>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" spacing="12.0">
                <Button fx:id="btnAdicionarMorador" onAction="#abrirCadastrarMorador" style="-fx-background-color: #7C3AED; -fx-text-fill: white; -fx-font-size: 13;                                -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 8; -fx-padding: 8 20;" text="+ Adicionar Morador" />
                <Button fx:id="btnVoltarDetalhes" onAction="#voltarDetalhesUnidade" style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-font-size: 13;                                -fx-cursor: hand; -fx-border-color: #334155; -fx-border-radius: 8;                                -fx-background-radius: 8; -fx-padding: 8 20;" text="← Detalhes da Unidade" />
            </HBox>
        </HBox>
    </top>

    <!-- ═══════════════════════ CONTEÚDO ═══════════════════════ -->
    <center>
        <VBox spacing="0.0" style="-fx-background-color: #F7F8FA; -fx-padding: 40 60 40 60;">

            <!-- Breadcrumb -->
            <HBox alignment="CENTER_LEFT" spacing="6.0" style="-fx-padding: 0 0 24 0;">
                <Label onMouseClicked="#voltarHome" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-cursor: hand;" text="Início" />
                <Label style="-fx-font-size: 12; -fx-text-fill: #94A3B8;" text="›" />
                <Label onMouseClicked="#voltarUnidades" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-cursor: hand;" text="Unidades" />
                <Label style="-fx-font-size: 12; -fx-text-fill: #94A3B8;" text="›" />
                <Label onMouseClicked="#voltarDetalhesUnidadeBreadCrumb" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-cursor: hand;" text="Detalhes" />
                <Label style="-fx-font-size: 12; -fx-text-fill: #94A3B8;" text="›" />
                <Label style="-fx-font-size: 12; -fx-text-fill: #1E293B;" text="Moradores" />
            </HBox>

            <!-- Título + counters -->
            <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-padding: 0 0 24 0;">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Moradores Vinculados" />
                    <Label fx:id="lblTotalMoradores" style="-fx-font-size: 13; -fx-text-fill: #64748B;" text="0 moradores nesta unidade" />
                </VBox>
                <!-- Badges de tipo -->
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <VBox alignment="CENTER" spacing="2.0" style="-fx-background-color: #EFF6FF; -fx-background-radius: 10; -fx-padding: 10 18;">
                        <Label fx:id="lblQtdProprietarios" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2563EB;" text="0" />
                        <Label style="-fx-font-size: 10; -fx-text-fill: #1E40AF;" text="Proprietário(s)" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="2.0" style="-fx-background-color: #ECFDF5; -fx-background-radius: 10; -fx-padding: 10 18;">
                        <Label fx:id="lblQtdInquilinos" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #059669;" text="0" />
                        <Label style="-fx-font-size: 10; -fx-text-fill: #065F46;" text="Inquilino(s)" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="2.0" style="-fx-background-color: #F5F3FF; -fx-background-radius: 10; -fx-padding: 10 18;">
                        <Label fx:id="lblQtdDependentes" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #7C3AED;" text="0" />
                        <Label style="-fx-font-size: 10; -fx-text-fill: #5B21B6;" text="Dependente(s)" />
                    </VBox>
                </HBox>
            </HBox>

            <!-- Card tabela -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #E2E8F0;                          -fx-border-radius: 16; -fx-border-width: 1;                          -fx-effect: dropshadow(gaussian, #00000010, 12, 0, 0, 2);" VBox.vgrow="ALWAYS">

                <!-- Barra de filtros -->
                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 18 24 18 24;                              -fx-border-color: transparent transparent #F1F5F9 transparent; -fx-border-width: 1;">
                    <HBox alignment="CENTER_LEFT" prefHeight="40.0" prefWidth="280.0" spacing="8.0" style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8;                                  -fx-background-radius: 8; -fx-border-width: 1; -fx-padding: 0 14;">
                        <Label style="-fx-font-size: 13; -fx-text-fill: #94A3B8;" text="🔍" />
                        <TextField fx:id="txtBusca" onKeyReleased="#filtrarMoradores" prefWidth="220.0" promptText="Buscar por nome ou CPF..." style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 13;" />
                    </HBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnLimparFiltros" onAction="#limparFiltros" style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-font-size: 12; -fx-cursor: hand;" text="Limpar" />
                </HBox>

                <!-- TableView -->
                <TableView fx:id="tabelaMoradores" prefHeight="460.0" style="-fx-background-color: transparent; -fx-border-color: transparent;                                   -fx-table-cell-border-color: #F1F5F9; -fx-font-size: 13;" VBox.vgrow="ALWAYS">
                    <columns>
                        <!-- Tipo com badge colorido -->
                        <TableColumn fx:id="colTipo" prefWidth="130.0" style="-fx-alignment: CENTER;" text="Tipo" />
                        <TableColumn fx:id="colNome" prefWidth="220.0" text="Nome" />
                        <TableColumn fx:id="colCpf" prefWidth="140.0" style="-fx-alignment: CENTER;" text="CPF" />
                        <TableColumn fx:id="colTelefone" prefWidth="140.0" text="Telefone" />
                        <TableColumn fx:id="colEmail" prefWidth="200.0" text="E-mail" />
                        <!-- Coluna extra: aparece só para Inquilino (data contrato) / Dependente (responsável) -->
                        <TableColumn fx:id="colExtra" prefWidth="180.0" text="Info Extra" />
                        <TableColumn fx:id="colStatus" prefWidth="110.0" style="-fx-alignment: CENTER;" text="Status" />
                        <TableColumn fx:id="colAcoes" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Ações" />
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="12.0">
                            <Label style="-fx-font-size: 36;" text="👥" />
                            <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #94A3B8;" text="Nenhum morador vinculado a esta unidade" />
                            <Label style="-fx-font-size: 12; -fx-text-fill: #CBD5E1;" text="Clique em '+ Adicionar Morador' para começar" />
                        </VBox>
                    </placeholder>
                </TableView>

                <!-- Rodapé de ações -->
                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 14 24 14 24;                              -fx-border-color: #F1F5F9 transparent transparent transparent; -fx-border-width: 1;                              -fx-background-color: #FAFBFC; -fx-background-radius: 0 0 16 16;">
                    <Button fx:id="btnVerDetalhes" onAction="#verDetalhesMorador" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 8;                                    -fx-padding: 9 20; -fx-font-size: 12; -fx-font-weight: bold; -fx-cursor: hand;" text="🔍  Detalhes" />
                    <Button fx:id="btnRemoverMorador" onAction="#confirmarRemocaoMorador" style="-fx-background-color: #FEF2F2; -fx-text-fill: #DC2626; -fx-background-radius: 8;                                    -fx-padding: 9 20; -fx-font-size: 12; -fx-cursor: hand;                                    -fx-border-color: #FECACA; -fx-border-radius: 8; -fx-border-width: 1;" text="🗑️  Remover da Unidade" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblSelecaoInfo" style="-fx-font-size: 12; -fx-text-fill: #94A3B8;" text="Selecione um morador para gerenciá-lo" />
                </HBox>
            </VBox>

        </VBox>
    </center>
</BorderPane>
