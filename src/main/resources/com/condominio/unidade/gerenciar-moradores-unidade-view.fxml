<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="gerenciarMoradoresRoot"
            prefHeight="750.0" prefWidth="1200.0"
            style="-fx-background-color: #F7F8FA;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.condominio.controller.unidade.GerenciarMoradoresUnidadeController">

    <!-- ═══════════════════════ HEADER ═══════════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="68.0"
              style="-fx-background-color: #1E293B; -fx-padding: 0 48 0 48;">
            <VBox alignment="CENTER_LEFT" spacing="2.0">
                <Label text="CondoSoft"
                       style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label text="Moradores da Unidade"
                           style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label fx:id="lblBadgeUnidade" text="Apto 101 – Bloco A"
                           style="-fx-background-color: #334155; -fx-text-fill: #94A3B8;
                                  -fx-background-radius: 6; -fx-padding: 4 12; -fx-font-size: 12;"/>
                </HBox>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="12.0" alignment="CENTER_RIGHT">
                <Button fx:id="btnAdicionarMorador" text="+ Adicionar Morador"
                        onAction="#abrirCadastrarMorador"
                        style="-fx-background-color: #7C3AED; -fx-text-fill: white; -fx-font-size: 13;
                               -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 8; -fx-padding: 8 20;"/>
                <Button fx:id="btnVoltarDetalhes" text="← Detalhes da Unidade"
                        onAction="#voltarDetalhesUnidade"
                        style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-font-size: 13;
                               -fx-cursor: hand; -fx-border-color: #334155; -fx-border-radius: 8;
                               -fx-background-radius: 8; -fx-padding: 8 20;"/>
            </HBox>
        </HBox>
    </top>

    <!-- ═══════════════════════ CONTEÚDO ═══════════════════════ -->
    <center>
        <VBox spacing="0.0" style="-fx-background-color: #F7F8FA; -fx-padding: 40 60 40 60;">

            <!-- Breadcrumb -->
            <HBox spacing="6.0" alignment="CENTER_LEFT" style="-fx-padding: 0 0 24 0;">
                <Label text="Início" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-cursor: hand;" onMouseClicked="#voltarHome"/>
                <Label text="›" style="-fx-font-size: 12; -fx-text-fill: #94A3B8;"/>
                <Label text="Unidades" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-cursor: hand;" onMouseClicked="#voltarUnidades"/>
                <Label text="›" style="-fx-font-size: 12; -fx-text-fill: #94A3B8;"/>
                <Label text="Detalhes" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-cursor: hand;" onMouseClicked="#voltarDetalhesUnidadeBreadCrumb"/>
                <Label text="›" style="-fx-font-size: 12; -fx-text-fill: #94A3B8;"/>
                <Label text="Moradores" style="-fx-font-size: 12; -fx-text-fill: #1E293B;"/>
            </HBox>

            <!-- Título + counters -->
            <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-padding: 0 0 24 0;">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label text="Moradores Vinculados"
                           style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                    <Label fx:id="lblTotalMoradores" text="0 moradores nesta unidade"
                           style="-fx-font-size: 13; -fx-text-fill: #64748B;"/>
                </VBox>
                <!-- Badges de tipo -->
                <HBox spacing="10.0" alignment="CENTER_RIGHT">
                    <VBox alignment="CENTER" spacing="2.0"
                          style="-fx-background-color: #EFF6FF; -fx-background-radius: 10; -fx-padding: 10 18;">
                        <Label fx:id="lblQtdProprietarios" text="0"
                               style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2563EB;"/>
                        <Label text="Proprietário(s)" style="-fx-font-size: 10; -fx-text-fill: #1E40AF;"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="2.0"
                          style="-fx-background-color: #ECFDF5; -fx-background-radius: 10; -fx-padding: 10 18;">
                        <Label fx:id="lblQtdInquilinos" text="0"
                               style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #059669;"/>
                        <Label text="Inquilino(s)" style="-fx-font-size: 10; -fx-text-fill: #065F46;"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="2.0"
                          style="-fx-background-color: #F5F3FF; -fx-background-radius: 10; -fx-padding: 10 18;">
                        <Label fx:id="lblQtdDependentes" text="0"
                               style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #7C3AED;"/>
                        <Label text="Dependente(s)" style="-fx-font-size: 10; -fx-text-fill: #5B21B6;"/>
                    </VBox>
                </HBox>
            </HBox>

            <!-- Card tabela -->
            <VBox VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #E2E8F0;
                         -fx-border-radius: 16; -fx-border-width: 1;
                         -fx-effect: dropshadow(gaussian, #00000010, 12, 0, 0, 2);">

                <!-- Barra de filtros -->
                <HBox alignment="CENTER_LEFT" spacing="12.0"
                      style="-fx-padding: 18 24 18 24;
                             -fx-border-color: transparent transparent #F1F5F9 transparent; -fx-border-width: 1;">
                    <HBox alignment="CENTER_LEFT" spacing="8.0"
                          style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8;
                                 -fx-background-radius: 8; -fx-border-width: 1; -fx-padding: 0 14;"
                          prefWidth="280.0" prefHeight="40.0">
                        <Label text="🔍" style="-fx-font-size: 13; -fx-text-fill: #94A3B8;"/>
                        <TextField fx:id="txtBusca" promptText="Buscar por nome ou CPF..."
                                   onKeyReleased="#filtrarMoradores"
                                   style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 13;"
                                   prefWidth="220.0"/>
                    </HBox>
                    <ComboBox fx:id="cmbFiltroTipo" promptText="Todos os Tipos"
                              prefWidth="180.0" prefHeight="40.0" onAction="#filtrarMoradores"
                              style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8;
                                     -fx-background-radius: 8; -fx-border-width: 1; -fx-font-size: 13;"/>
                    <ComboBox fx:id="cmbFiltroStatus" promptText="Todos os Status"
                              prefWidth="180.0" prefHeight="40.0" onAction="#filtrarMoradores"
                              style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8;
                                     -fx-background-radius: 8; -fx-border-width: 1; -fx-font-size: 13;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnLimparFiltros" text="Limpar"
                            onAction="#limparFiltros"
                            style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-font-size: 12; -fx-cursor: hand;"/>
                </HBox>

                <!-- TableView -->
                <TableView fx:id="tabelaMoradores" VBox.vgrow="ALWAYS" prefHeight="460.0"
                           style="-fx-background-color: transparent; -fx-border-color: transparent;
                                  -fx-table-cell-border-color: #F1F5F9; -fx-font-size: 13;">
                    <columns>
                        <!-- Tipo com badge colorido -->
                        <TableColumn fx:id="colTipo"      text="Tipo"        prefWidth="130.0" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colNome"      text="Nome"        prefWidth="220.0"/>
                        <TableColumn fx:id="colCpf"       text="CPF"         prefWidth="140.0" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colTelefone"  text="Telefone"    prefWidth="140.0"/>
                        <TableColumn fx:id="colEmail"     text="E-mail"      prefWidth="200.0"/>
                        <!-- Coluna extra: aparece só para Inquilino (data contrato) / Dependente (responsável) -->
                        <TableColumn fx:id="colExtra"     text="Info Extra"  prefWidth="180.0"/>
                        <TableColumn fx:id="colStatus"    text="Status"      prefWidth="110.0" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colAcoes"     text="Ações"       prefWidth="120.0" style="-fx-alignment: CENTER;"/>
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="12.0">
                            <Label text="👥" style="-fx-font-size: 36;"/>
                            <Label text="Nenhum morador vinculado a esta unidade"
                                   style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                            <Label text="Clique em '+ Adicionar Morador' para começar"
                                   style="-fx-font-size: 12; -fx-text-fill: #CBD5E1;"/>
                        </VBox>
                    </placeholder>
                </TableView>

                <!-- Rodapé de ações -->
                <HBox alignment="CENTER_LEFT" spacing="12.0"
                      style="-fx-padding: 14 24 14 24;
                             -fx-border-color: #F1F5F9 transparent transparent transparent; -fx-border-width: 1;
                             -fx-background-color: #FAFBFC; -fx-background-radius: 0 0 16 16;">
                    <Button fx:id="btnVerDetalhes" text="🔍  Detalhes"
                            onAction="#verDetalhesMorador"
                            style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 8;
                                   -fx-padding: 9 20; -fx-font-size: 12; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    <Button fx:id="btnEditarMorador" text="✏️  Editar"
                            onAction="#editarMorador"
                            style="-fx-background-color: #F1F5F9; -fx-text-fill: #374151; -fx-background-radius: 8;
                                   -fx-padding: 9 20; -fx-font-size: 12; -fx-cursor: hand;
                                   -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-border-width: 1;"/>
                    <Button fx:id="btnRemoverMorador" text="🗑️  Remover da Unidade"
                            onAction="#confirmarRemocaoMorador"
                            style="-fx-background-color: #FEF2F2; -fx-text-fill: #DC2626; -fx-background-radius: 8;
                                   -fx-padding: 9 20; -fx-font-size: 12; -fx-cursor: hand;
                                   -fx-border-color: #FECACA; -fx-border-radius: 8; -fx-border-width: 1;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblSelecaoInfo" text="Selecione um morador para gerenciá-lo"
                           style="-fx-font-size: 12; -fx-text-fill: #94A3B8;"/>
                </HBox>
            </VBox>

        </VBox>
    </center>
</BorderPane>
