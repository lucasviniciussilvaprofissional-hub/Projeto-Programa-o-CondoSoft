<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="portariaRoot" prefHeight="750.0" prefWidth="1200.0"
            style="-fx-background-color: #F7F8FA;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.condominio.controller.portaria.PortariaController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="68.0"
              style="-fx-background-color: #1E293B; -fx-padding: 0 48 0 48;">
            <VBox alignment="CENTER_LEFT" spacing="2.0">
                <Label text="CondoSoft"
                       style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                <Label text="Portaria"
                       style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnVoltarHome"
                    text="← Início"
                    onAction="#voltarHome"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #94A3B8;
                           -fx-font-size: 13;
                           -fx-cursor: hand;
                           -fx-border-color: #334155;
                           -fx-border-radius: 8;
                           -fx-background-radius: 8;
                           -fx-padding: 8 20;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: #F7F8FA;
                           -fx-background-color: #F7F8FA;
                           -fx-border-color: transparent;">

            <VBox spacing="32.0"
                  style="-fx-background-color: #F7F8FA;
                         -fx-padding: 48 60 48 60;">

                <HBox spacing="6.0" alignment="CENTER_LEFT">
                    <Label text="Início"
                           onMouseClicked="#voltarHomeMouse"
                           style="-fx-font-size: 12;
                                  -fx-text-fill: #2563EB;
                                  -fx-cursor: hand;"/>

                    <Label text="&gt;"
                           style="-fx-font-size: 12;
                                  -fx-text-fill: #94A3B8;"/>

                    <Label text="Portaria"
                           style="-fx-font-size: 12;
                                  -fx-text-fill: #1E293B;"/>
                </HBox>

                <VBox spacing="6.0">
                    <Label text="Gestão da Portaria"
                           style="-fx-font-size: 26;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #1E293B;"/>

                    <Label text="Gerencie visitantes, prestadores de serviço, encomendas e ocorrências"
                           style="-fx-font-size: 13;
                                  -fx-text-fill: #64748B;"/>
                </VBox>

                <Separator/>

                <GridPane hgap="16.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25.0"/>
                        <ColumnConstraints percentWidth="25.0"/>
                        <ColumnConstraints percentWidth="25.0"/>
                        <ColumnConstraints percentWidth="25.0"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="90.0"/>
                    </rowConstraints>

                    <VBox GridPane.columnIndex="0" spacing="6.0"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 20 24;">
                        <Label text="ACESSOS HOJE" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                        <Label fx:id="lblAcessosHoje" text="0" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #2563EB;"/>
                    </VBox>

                    <VBox GridPane.columnIndex="1" spacing="6.0"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 20 24;">
                        <Label text="PRESTADORES" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                        <Label fx:id="lblPrestadores" text="0" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #D97706;"/>
                    </VBox>

                    <VBox GridPane.columnIndex="2" spacing="6.0"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 20 24;">
                        <Label text="ENCOMENDAS" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                        <Label fx:id="lblEncomendas" text="0" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #059669;"/>
                    </VBox>

                    <VBox GridPane.columnIndex="3" spacing="6.0"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 20 24;">
                        <Label text="OCORRÊNCIAS" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                        <Label fx:id="lblOcorrencias" text="0" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #DC2626;"/>
                    </VBox>
                </GridPane>

                <Label text="MÓDULOS" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>

                <GridPane hgap="24.0" vgap="24.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.33"/>
                        <ColumnConstraints percentWidth="33.33"/>
                        <ColumnConstraints percentWidth="33.33"/>
                    </columnConstraints>

                    <VBox GridPane.columnIndex="0" spacing="16.0"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #E2E8F0; -fx-border-radius: 16; -fx-border-width: 1; -fx-padding: 32;">
                        <Label text="🚪" style="-fx-font-size: 28;"/>
                        <VBox spacing="8.0">
                            <Label text="Controle de Acesso" style="-fx-font-size: 17; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                            <Label text="Gerencie visitantes, técnicos, prestadores e entregadores." wrapText="true" style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
                        </VBox>
                        <Region VBox.vgrow="ALWAYS"/>
                        <Button text="Gerenciar" fx:id="btnControleAcesso" onAction="#abrirControleAcesso" maxWidth="Infinity" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 12 24; -fx-font-size: 13; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </VBox>

                    <VBox GridPane.columnIndex="1" spacing="16.0"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #E2E8F0; -fx-border-radius: 16; -fx-border-width: 1; -fx-padding: 32;">
                        <Label text="📦" style="-fx-font-size: 28;"/>
                        <VBox spacing="8.0">
                            <Label text="Encomendas" style="-fx-font-size: 17; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                            <Label text="Controle encomendas recebidas e retiradas." wrapText="true" style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
                        </VBox>
                        <Region VBox.vgrow="ALWAYS"/>
                        <Button text="Gerenciar" fx:id="btnEncomendas" onAction="#abrirEncomendas" maxWidth="Infinity" style="-fx-background-color: #059669; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 12 24; -fx-font-size: 13; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </VBox>

                    <VBox GridPane.columnIndex="2" spacing="16.0"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #E2E8F0; -fx-border-radius: 16; -fx-border-width: 1; -fx-padding: 32;">
                        <Label text="⚠️" style="-fx-font-size: 28;"/>
                        <VBox spacing="8.0">
                            <Label text="Ocorrências" style="-fx-font-size: 17; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                            <Label text="Registre problemas e situações da portaria." wrapText="true" style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
                        </VBox>
                        <Region VBox.vgrow="ALWAYS"/>
                        <Button text="Gerenciar" fx:id="btnOcorrencias" onAction="#abrirOcorrencias" maxWidth="Infinity" style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 12 24; -fx-font-size: 13; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </VBox>
                </GridPane>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>