<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="750.0" prefWidth="1200.0"
            style="-fx-background-color: #F7F8FA;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.condominio.controller.portaria.EncomendasController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="68.0" style="-fx-background-color: #1E293B; -fx-padding: 0 48;">
            <VBox alignment="CENTER_LEFT" spacing="2.0">
                <Label text="CondoSoft" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                <Label text="Controle de Encomendas" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="← Voltar à Portaria"
                    onAction="#voltarPortaria"
                    style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-font-size: 13; -fx-cursor: hand; -fx-border-color: #334155; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 20;"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="24.0" style="-fx-padding: 48 60;">

            <VBox prefWidth="380.0" spacing="20.0"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-padding: 28;">
                <Label text="Registrar Entrada de Pacote" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                <Separator/>
                <VBox spacing="6.0">
                    <Label text="Morador / Destinatário" style="-fx-text-fill: #64748B; -fx-font-weight: bold; -fx-font-size: 12;"/>
                    <TextField fx:id="txtMorador" promptText="Ex: Lucas" style="-fx-padding: 10; -fx-background-radius: 6;"/>
                </VBox>
                <VBox spacing="6.0">
                    <Label text="Apartamento / Unidade" style="-fx-text-fill: #64748B; -fx-font-weight: bold; -fx-font-size: 12;"/>
                    <TextField fx:id="txtApartamento" promptText="Ex: Apto 102" style="-fx-padding: 10; -fx-background-radius: 6;"/>
                </VBox>
                <Button text="Registrar Recebimento" onAction="#salvarEncomenda" maxWidth="Infinity"
                        style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 13;"/>
            </VBox>

            <VBox HBox.hgrow="ALWAYS" spacing="16.0"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-padding: 28;">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Histórico de Encomendas na Portaria" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Marcar como Retirado" onAction="#marcarRetirado"
                            style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand;"/>
                </HBox>
                <TableView fx:id="tabelaEncomendas" VBox.vgrow="ALWAYS" style="-fx-background-radius: 8;">
                    <columns>
                        <TableColumn fx:id="colMorador" text="Morador" prefWidth="250"/>
                        <TableColumn fx:id="colApartamento" text="Unidade" prefWidth="150"/>
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="150"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>

        </HBox>
    </center>
</BorderPane>