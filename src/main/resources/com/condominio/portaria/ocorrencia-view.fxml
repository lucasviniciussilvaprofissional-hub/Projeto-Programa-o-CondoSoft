<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="750.0" prefWidth="1200.0"
            style="-fx-background-color: #F7F8FA;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.condominio.controller.portaria.OcorrenciaController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="68.0" style="-fx-background-color: #1E293B; -fx-padding: 0 48;">
            <VBox alignment="CENTER_LEFT" spacing="2.0">
                <Label text="CondoSoft" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                <Label text="Livro de Ocorrências Digital" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="← Voltar à Portaria"
                    onAction="#voltarPortaria"
                    style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-font-size: 13; -fx-cursor: hand; -fx-border-color: #334155; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 20;"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="24.0" style="-fx-padding: 48 60;">

            <VBox prefWidth="400.0" spacing="16.0"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-padding: 28;">
                <Label text="Registrar Nova Ocorrência" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                <Separator/>

                <HBox spacing="12.0">
                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                        <Label text="Apartamento/Unidade" style="-fx-text-fill: #64748B; -fx-font-weight: bold; -fx-font-size: 12;"/>
                        <ComboBox fx:id="cbUnidade" onAction="#aoSelecionarUnidade" maxWidth="Infinity" style="-fx-padding: 6; -fx-background-radius: 6;" promptText="Selecione..."/>
                    </VBox>
                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                        <Label text="Tipo" style="-fx-text-fill: #64748B; -fx-font-weight: bold; -fx-font-size: 12;"/>
                        <ComboBox fx:id="cbTipo" maxWidth="Infinity" style="-fx-padding: 6; -fx-background-radius: 6;"/>
                    </VBox>
                </HBox>

                <VBox spacing="6.0">
                    <Label text="Morador Envolvido" style="-fx-text-fill: #64748B; -fx-font-weight: bold; -fx-font-size: 12;"/>
                    <ComboBox fx:id="cbMorador" maxWidth="Infinity" style="-fx-padding: 6; -fx-background-radius: 6;" promptText="Selecione a unidade antes..."/>
                </VBox>

                <VBox spacing="6.0">
                    <Label text="Título Resumido" style="-fx-text-fill: #64748B; -fx-font-weight: bold; -fx-font-size: 12;"/>
                    <TextField fx:id="txtTitulo" promptText="Ex: Barulho excessivo após às 22h" style="-fx-padding: 10; -fx-background-radius: 6;"/>
                </VBox>

                <VBox spacing="6.0" VBox.vgrow="ALWAYS">
                    <Label text="Descrição Detalhada dos Fatos" style="-fx-text-fill: #64748B; -fx-font-weight: bold; -fx-font-size: 12;"/>
                    <TextArea fx:id="txtDescricao" promptText="Descreva o acontecido detalhadamente..." wrapText="true" prefHeight="150.0" style="-fx-background-radius: 6;"/>
                </VBox>

                <Button text="Gravar Ocorrência" onAction="#salvarOcorrencia" maxWidth="Infinity"
                        style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 13;"/>
            </VBox>

            <VBox HBox.hgrow="ALWAYS" spacing="16.0"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-padding: 28;">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Histórico de Ocorrências Pendentes" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Resolver Ocorrência" onAction="#resolverOcorrencia"
                            style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand;"/>
                </HBox>

                <TableView fx:id="tabelaOcorrencias" VBox.vgrow="ALWAYS" style="-fx-background-radius: 8;">
                    <columns>
                        <TableColumn fx:id="colUnidade" text="Unidade" prefWidth="100"/>
                        <TableColumn fx:id="colTipo" text="Tipo" prefWidth="140"/>
                        <TableColumn fx:id="colTitulo" text="Título" prefWidth="250"/>
                        <TableColumn fx:id="colDescricao" text="Descrição" prefWidth="300"/>
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="120"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>

        </HBox>
    </center>
</BorderPane>