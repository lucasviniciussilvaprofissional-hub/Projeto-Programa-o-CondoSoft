<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="disciplinaRoot" prefHeight="750.0" prefWidth="1200.0"
            style="-fx-background-color: #F7F8FA;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.condominio.controller.disciplina.DisciplinaController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="68.0"
              style="-fx-background-color: #1E293B; -fx-padding: 0 48 0 48;">
            <VBox alignment="CENTER_LEFT" spacing="2">
                <Label text="CondoSoft"
                       style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                <Label text="Disciplina"
                       style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnVoltarHome"
                    text="? Início"
                    onAction="#voltarHome"
                    style="-fx-background-color: transparent; -fx-text-fill: #94A3B8;
                           -fx-border-color: #334155; -fx-border-radius: 8;
                           -fx-background-radius: 8; -fx-padding: 8 20;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="28"
              style="-fx-background-color: #F7F8FA; -fx-padding: 40 60 40 60;">

            <HBox spacing="6">
                <Label text="Início"
                       style="-fx-font-size: 12; -fx-text-fill: #2563EB;"/>
                <Label text="›"
                       style="-fx-font-size: 12; -fx-text-fill: #94A3B8;"/>
                <Label text="Disciplina"
                       style="-fx-font-size: 12; -fx-text-fill: #1E293B;"/>
            </HBox>

            <VBox spacing="6">
                <Label text="Controle Disciplinar"
                       style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                <Label text="Registro de advertências, multas e ocorrências do condomínio"
                       style="-fx-font-size: 13; -fx-text-fill: #64748B;"/>
            </VBox>

            <Separator/>

            <GridPane hgap="16">

                <columnConstraints>
                    <ColumnConstraints percentWidth="33.33"/>
                    <ColumnConstraints percentWidth="33.33"/>
                    <ColumnConstraints percentWidth="33.33"/>
                </columnConstraints>

                <rowConstraints>
                    <RowConstraints minHeight="90"/>
                </rowConstraints>

                <VBox GridPane.columnIndex="0"
                      spacing="6"
                      style="-fx-background-color: white; -fx-padding: 20 24;
                             -fx-background-radius: 12;
                             -fx-border-color: #E2E8F0;
                             -fx-border-radius: 12;">

                    <Label text="OCORRÊNCIAS"
                           style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>

                    <Label fx:id="lblTotalOcorrencias"
                           text="0"
                           style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2563EB;"/>
                </VBox>

                <VBox GridPane.columnIndex="1"
                      spacing="6"
                      style="-fx-background-color: white; -fx-padding: 20 24;
                             -fx-background-radius: 12;
                             -fx-border-color: #E2E8F0;
                             -fx-border-radius: 12;">

                    <Label text="ADVERTÊNCIAS"
                           style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>

                    <Label fx:id="lblAdvertencias"
                           text="0"
                           style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #D97706;"/>
                </VBox>

                <VBox GridPane.columnIndex="2"
                      spacing="6"
                      style="-fx-background-color: white; -fx-padding: 20 24;
                             -fx-background-radius: 12;
                             -fx-border-color: #E2E8F0;
                             -fx-border-radius: 12;">

                    <Label text="MULTAS"
                           style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>

                    <Label fx:id="lblMultas"
                           text="0"
                           style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #DC2626;"/>
                </VBox>

            </GridPane>

            <HBox spacing="24">

                <VBox prefWidth="380"
                      spacing="18"
                      style="-fx-background-color: white;
                             -fx-background-radius: 16;
                             -fx-border-color: #E2E8F0;
                             -fx-border-radius: 16;
                             -fx-padding: 30;">

                    <Label text="REGISTRAR OCORRÊNCIA"
                           style="-fx-font-size: 16; -fx-font-weight: bold;"/>

                    <Separator/>

                    <VBox spacing="6">
                        <Label text="Unidade"/>
                        <ComboBox fx:id="cmbUnidade"
                                  promptText="Selecione a unidade..."
                                  maxWidth="Infinity"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Morador"/>
                        <TextField fx:id="txtMorador"
                                   promptText="Nome do morador"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Tipo"/>
                        <ComboBox fx:id="cmbTipoOcorrencia"
                                  promptText="Selecione o tipo..."
                                  maxWidth="Infinity"/>
                    </VBox>

                    <VBox spacing="6">
                        <Label text="Descrição"/>
                        <TextArea fx:id="txtDescricao"
                                  prefHeight="120"
                                  wrapText="true"/>
                    </VBox>

                    <HBox spacing="12">

                        <Button text="Limpar"
                                onAction="#limparFormulario"
                                maxWidth="Infinity"
                                HBox.hgrow="ALWAYS"
                                style="-fx-background-color: #F1F5F9;"/>

                        <Button fx:id="btnRegistrarOcorrencia"
                                text="Registrar"
                                onAction="#registrarOcorrencia"
                                maxWidth="Infinity"
                                HBox.hgrow="ALWAYS"
                                style="-fx-background-color: #DC2626;
                                       -fx-text-fill: white;
                                       -fx-font-weight: bold;"/>

                    </HBox>

                </VBox>

                <VBox spacing="0"
                      HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white;
                             -fx-background-radius: 16;
                             -fx-border-color: #E2E8F0;
                             -fx-border-radius: 16;">

                    <HBox style="-fx-padding: 20 24;">
                        <Label text="Histórico de Ocorrências"
                               style="-fx-font-size: 16; -fx-font-weight: bold;"/>
                    </HBox>

                    <TableView fx:id="tabelaOcorrencias"
                               VBox.vgrow="ALWAYS">

                        <columns>

                            <TableColumn fx:id="colUnidade"
                                         text="Unidade"
                                         prefWidth="100"/>

                            <TableColumn fx:id="colMorador"
                                         text="Morador"
                                         prefWidth="180"/>

                            <TableColumn fx:id="colTipo"
                                         text="Tipo"
                                         prefWidth="180"/>

                            <TableColumn fx:id="colData"
                                         text="Data"
                                         prefWidth="120"/>

                            <TableColumn fx:id="colStatus"
                                         text="Status"
                                         prefWidth="120"/>

                        </columns>

                    </TableView>

                </VBox>

            </HBox>

        </VBox>
    </center>

</BorderPane>