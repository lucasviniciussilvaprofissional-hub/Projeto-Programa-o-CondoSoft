<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="850.0"
            prefWidth="1400.0"
            style="-fx-background-color: #F7F8FA;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.condominio.controller.disciplina.DisciplinaController">

    <!-- HEADER -->

    <top>
        <HBox alignment="CENTER_LEFT"
              prefHeight="70"
              style="-fx-background-color: #1E293B; -fx-padding: 0 40;">

            <VBox spacing="2">
                <Label text="CondoSoft"
                       style="-fx-text-fill:white; -fx-font-size:18; -fx-font-weight:bold;"/>

                <Label text="Controle Disciplinar"
                       style="-fx-text-fill:#94A3B8; -fx-font-size:11;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnVoltarHome"
                    text="← Início"
                    onAction="#voltarHome"
                    style="-fx-background-color:#334155;
                           -fx-text-fill:white;
                           -fx-background-radius:8;
                           -fx-cursor:hand;"/>
        </HBox>
    </top>

    <!-- CONTEÚDO -->

    <center>

        <ScrollPane fitToWidth="true">

            <VBox spacing="25"
                  style="-fx-padding:35; -fx-background-color:#F7F8FA;">

                <!-- Breadcrumb -->

                <HBox spacing="5">
                    <Label text="Início"
                           style="-fx-text-fill:#2563EB;"/>

                    <Label text="›"/>

                    <Label text="Disciplina"/>
                </HBox>

                <!-- Título -->

                <VBox spacing="5">

                    <Label text="Controle Disciplinar"
                           style="-fx-font-size:28;
                                  -fx-font-weight:bold;
                                  -fx-text-fill:#1E293B;"/>

                    <Label text="Gerencie ocorrências, advertências e multas."
                           style="-fx-text-fill:#64748B;"/>

                </VBox>

                <Separator/>

                <!-- Cards -->

                <GridPane hgap="15">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.33"/>
                        <ColumnConstraints percentWidth="33.33"/>
                        <ColumnConstraints percentWidth="33.33"/>
                    </columnConstraints>

                    <rowConstraints>
                        <RowConstraints minHeight="100"/>
                    </rowConstraints>

                    <!-- Card 1 -->

                    <VBox GridPane.columnIndex="0"
                          spacing="6"
                          style="-fx-background-color:white;
                                 -fx-background-radius:12;
                                 -fx-border-color:#E2E8F0;
                                 -fx-border-radius:12;
                                 -fx-padding:20;">

                        <Label text="OCORRÊNCIAS"
                               style="-fx-font-size:11;
                                      -fx-font-weight:bold;
                                      -fx-text-fill:#94A3B8;"/>

                        <Label fx:id="lblTotalOcorrencias"
                               text="0"
                               style="-fx-font-size:26;
                                      -fx-font-weight:bold;
                                      -fx-text-fill:#2563EB;"/>
                    </VBox>

                    <!-- Card 2 -->

                    <VBox GridPane.columnIndex="1"
                          spacing="6"
                          style="-fx-background-color:white;
                                 -fx-background-radius:12;
                                 -fx-border-color:#E2E8F0;
                                 -fx-border-radius:12;
                                 -fx-padding:20;">

                        <Label text="ADVERTÊNCIAS"
                               style="-fx-font-size:11;
                                      -fx-font-weight:bold;
                                      -fx-text-fill:#94A3B8;"/>

                        <Label fx:id="lblAdvertencias"
                               text="0"
                               style="-fx-font-size:26;
                                      -fx-font-weight:bold;
                                      -fx-text-fill:#D97706;"/>
                    </VBox>

                    <!-- Card 3 -->

                    <VBox GridPane.columnIndex="2"
                          spacing="6"
                          style="-fx-background-color:white;
                                 -fx-background-radius:12;
                                 -fx-border-color:#E2E8F0;
                                 -fx-border-radius:12;
                                 -fx-padding:20;">

                        <Label text="MULTAS"
                               style="-fx-font-size:11;
                                      -fx-font-weight:bold;
                                      -fx-text-fill:#94A3B8;"/>

                        <Label fx:id="lblMultas"
                               text="0"
                               style="-fx-font-size:26;
                                      -fx-font-weight:bold;
                                      -fx-text-fill:#DC2626;"/>
                    </VBox>

                </GridPane>

                <!-- Área principal -->

                <HBox spacing="20">

                    <!-- Formulário -->

                    <VBox prefWidth="400"
                          spacing="15"
                          style="-fx-background-color:white;
                                 -fx-background-radius:12;
                                 -fx-border-color:#E2E8F0;
                                 -fx-border-radius:12;
                                 -fx-padding:25;">

                        <Label text="Registrar Ocorrência"
                               style="-fx-font-size:18;
                                      -fx-font-weight:bold;"/>

                        <Separator/>

                        <VBox spacing="5">
                            <Label text="Unidade"/>
                            <ComboBox fx:id="cbUnidade"
                                      promptText="Selecione a unidade"/>
                        </VBox>

                        <VBox spacing="5">
                            <Label text="Morador"/>
                            <TextField fx:id="txtMorador"
                                       promptText="Nome do morador"/>
                        </VBox>

                        <VBox spacing="5">
                            <Label text="Tipo de Ocorrência"/>
                            <ComboBox fx:id="cmbTipoOcorrencia"
                                      promptText="Selecione"/>
                        </VBox>

                        <VBox spacing="5">
                            <Label text="Descrição"/>
                            <TextArea fx:id="txtDescricao"
                                      prefHeight="150"/>
                        </VBox>

                        <HBox spacing="10">

                            <Button text="Limpar"
                                    onAction="#limparFormulario"
                                    maxWidth="Infinity"
                                    HBox.hgrow="ALWAYS"/>

                            <Button fx:id="btnRegistrarOcorrencia"
                                    text="Registrar"
                                    onAction="#registrarOcorrencia"
                                    maxWidth="Infinity"
                                    HBox.hgrow="ALWAYS"
                                    style="-fx-background-color:#DC2626;
                                           -fx-text-fill:white;
                                           -fx-font-weight:bold;"/>
                        </HBox>

                    </VBox>

                    <!-- Tabela -->

                    <VBox spacing="10"
                          HBox.hgrow="ALWAYS"
                          style="-fx-background-color:white;
                                 -fx-background-radius:12;
                                 -fx-border-color:#E2E8F0;
                                 -fx-border-radius:12;
                                 -fx-padding:20;">

                        <Label text="Histórico de Ocorrências"
                               style="-fx-font-size:18;
                                      -fx-font-weight:bold;"/>

                        <TableView fx:id="tabelaOcorrencias"
                                   prefHeight="600"
                                   VBox.vgrow="ALWAYS">

                            <columns>

                                <TableColumn fx:id="colUnidade"
                                             text="Unidade"
                                             prefWidth="120"/>

                                <TableColumn fx:id="colMorador"
                                             text="Morador"
                                             prefWidth="220"/>

                                <TableColumn fx:id="colTipo"
                                             text="Tipo"
                                             prefWidth="220"/>

                                <TableColumn fx:id="colData"
                                             text="Data"
                                             prefWidth="140"/>

                                <TableColumn fx:id="colStatus"
                                             text="Status"
                                             prefWidth="140"/>

                            </columns>

                        </TableView>

                    </VBox>

                </HBox>

            </VBox>

        </ScrollPane>

    </center>

</BorderPane>