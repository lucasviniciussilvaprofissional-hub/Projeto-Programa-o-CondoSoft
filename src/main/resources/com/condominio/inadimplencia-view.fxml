<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="inadimplenciaRoot" prefHeight="750.0" prefWidth="1200.0"
            style="-fx-background-color: #F7F8FA;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.condosoft.controller.InadimplenciaController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="68.0"
              style="-fx-background-color: #1E293B; -fx-padding: 0 48 0 48;">
            <VBox alignment="CENTER_LEFT" spacing="2.0">
                <Label text="CondoSoft" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                <Label text="Inadimplência" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnVoltarFinanceiro" text="← Financeiro" onAction="#voltarFinanceiro"
                    style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-font-size: 13;
                           -fx-cursor: hand; -fx-border-color: #334155; -fx-border-radius: 8;
                           -fx-background-radius: 8; -fx-padding: 8 20;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="0.0" style="-fx-background-color: #F7F8FA; -fx-padding: 40 60 40 60;">

            <HBox spacing="6.0" alignment="CENTER_LEFT" style="-fx-padding: 0 0 24 0;">
                <Label text="Início" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-cursor: hand;" onMouseClicked="#voltarHome"/>
                <Label text="›" style="-fx-font-size: 12; -fx-text-fill: #94A3B8;"/>
                <Label text="Financeiro" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-cursor: hand;" onMouseClicked="#voltarFinanceiro"/>
                <Label text="›" style="-fx-font-size: 12; -fx-text-fill: #94A3B8;"/>
                <Label text="Inadimplência" style="-fx-font-size: 12; -fx-text-fill: #1E293B;"/>
            </HBox>

            <!-- Título + KPIs -->
            <HBox spacing="20.0" style="-fx-padding: 0 0 24 0;">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label text="Devedores" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                    <Label text="Unidades com pagamentos em atraso" style="-fx-font-size: 13; -fx-text-fill: #64748B;"/>
                </VBox>
                <GridPane hgap="14.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="130.0"/>
                        <ColumnConstraints minWidth="130.0"/>
                        <ColumnConstraints minWidth="130.0"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="70.0"/>
                    </rowConstraints>
                    <VBox GridPane.columnIndex="0" alignment="CENTER_LEFT" spacing="4.0"
                          style="-fx-background-color: #FEF2F2; -fx-background-radius: 10; -fx-border-color: #FECACA;
                                 -fx-border-radius: 10; -fx-border-width: 1; -fx-padding: 14 20;">
                        <Label text="DEVEDORES" style="-fx-font-size: 9; -fx-font-weight: bold; -fx-text-fill: #991B1B;"/>
                        <Label fx:id="lblNumDevedores" text="0"
                               style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #DC2626;"/>
                    </VBox>
                    <VBox GridPane.columnIndex="1" alignment="CENTER_LEFT" spacing="4.0"
                          style="-fx-background-color: #FEF2F2; -fx-background-radius: 10; -fx-border-color: #FECACA;
                                 -fx-border-radius: 10; -fx-border-width: 1; -fx-padding: 14 20;">
                        <Label text="TOTAL EM ATRASO" style="-fx-font-size: 9; -fx-font-weight: bold; -fx-text-fill: #991B1B;"/>
                        <Label fx:id="lblTotalAtraso" text="R$ 0,00"
                               style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #DC2626;"/>
                    </VBox>
                    <VBox GridPane.columnIndex="2" alignment="CENTER_LEFT" spacing="4.0"
                          style="-fx-background-color: #FFFBEB; -fx-background-radius: 10; -fx-border-color: #FDE68A;
                                 -fx-border-radius: 10; -fx-border-width: 1; -fx-padding: 14 20;">
                        <Label text="MAIOR ATRASO" style="-fx-font-size: 9; -fx-font-weight: bold; -fx-text-fill: #78350F;"/>
                        <Label fx:id="lblMaiorAtraso" text="0 dias"
                               style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #D97706;"/>
                    </VBox>
                </GridPane>
            </HBox>

            <!-- Card tabela -->
            <VBox VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #E2E8F0;
                         -fx-border-radius: 16; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, #00000010, 12, 0, 0, 2);">

                <!-- Barra de filtros -->
                <HBox alignment="CENTER_LEFT" spacing="12.0"
                      style="-fx-padding: 18 24 18 24; -fx-border-color: transparent transparent #F1F5F9 transparent; -fx-border-width: 1;">
                    <HBox alignment="CENTER_LEFT" spacing="8.0"
                          style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8;
                                 -fx-background-radius: 8; -fx-border-width: 1; -fx-padding: 0 14;"
                          prefWidth="260.0" prefHeight="40.0">
                        <Label text="🔍" style="-fx-font-size: 13; -fx-text-fill: #94A3B8;"/>
                        <TextField fx:id="txtBusca" promptText="Buscar unidade ou morador..."
                                   onKeyReleased="#filtrarDevedores"
                                   style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 13;"
                                   prefWidth="200.0"/>
                    </HBox>
                    <ComboBox fx:id="cmbFiltroBloco" promptText="Todos os Blocos"
                              prefWidth="150.0" prefHeight="40.0" onAction="#filtrarDevedores"
                              style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8;
                                     -fx-background-radius: 8; -fx-border-width: 1; -fx-font-size: 13;"/>
                    <ComboBox fx:id="cmbFiltroAtraso" promptText="Todos os Atrasos"
                              prefWidth="170.0" prefHeight="40.0" onAction="#filtrarDevedores"
                              style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8;
                                     -fx-background-radius: 8; -fx-border-width: 1; -fx-font-size: 13;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnExportarLista" text="⬇  Exportar Lista" onAction="#exportarLista"
                            style="-fx-background-color: #F1F5F9; -fx-text-fill: #374151; -fx-background-radius: 8;
                                   -fx-padding: 9 20; -fx-font-size: 12; -fx-cursor: hand;
                                   -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-border-width: 1;"/>
                </HBox>

                <TableView fx:id="tabelaDevedores" VBox.vgrow="ALWAYS" prefHeight="440.0"
                           style="-fx-background-color: transparent; -fx-border-color: transparent;
                                  -fx-table-cell-border-color: #F1F5F9; -fx-font-size: 13;">
                    <columns>
                        <TableColumn fx:id="colUnidade" text="Unidade" prefWidth="100.0"/>
                        <TableColumn fx:id="colBloco" text="Bloco" prefWidth="80.0" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colMorador" text="Responsável" prefWidth="180.0"/>
                        <TableColumn fx:id="colMesesAtraso" text="Meses em Atraso" prefWidth="140.0" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colDiasAtraso" text="Dias" prefWidth="80.0" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colValorTotal" text="Total Devido" prefWidth="130.0" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colSituacao" text="Situação" prefWidth="120.0" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colAcoes" text="Ações" prefWidth="150.0" style="-fx-alignment: CENTER;"/>
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="12.0">
                            <Label text="✅" style="-fx-font-size: 36;"/>
                            <Label text="Nenhuma inadimplência registrada"
                                   style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #059669;"/>
                            <Label text="Todos os pagamentos estão em dia"
                                   style="-fx-font-size: 12; -fx-text-fill: #94A3B8;"/>
                        </VBox>
                    </placeholder>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="12.0"
                      style="-fx-padding: 14 24 14 24; -fx-border-color: #F1F5F9 transparent transparent transparent;
                             -fx-border-width: 1; -fx-background-color: #FAFBFC; -fx-background-radius: 0 0 16 16;">
                    <Button fx:id="btnRegistrarAcordo" text="🤝  Registrar Acordo" onAction="#registrarAcordo"
                            style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 8;
                                   -fx-padding: 9 20; -fx-font-size: 12; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    <Button fx:id="btnEnviarNotificacao" text="📧  Notificar" onAction="#enviarNotificacao"
                            style="-fx-background-color: #F1F5F9; -fx-text-fill: #374151; -fx-background-radius: 8;
                                   -fx-padding: 9 20; -fx-font-size: 12; -fx-cursor: hand;
                                   -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-border-width: 1;"/>
                    <Button fx:id="btnQuitarDebito" text="✅  Quitar Débito" onAction="#quitarDebito"
                            style="-fx-background-color: #F0FDF4; -fx-text-fill: #059669; -fx-background-radius: 8;
                                   -fx-padding: 9 20; -fx-font-size: 12; -fx-cursor: hand;
                                   -fx-border-color: #BBF7D0; -fx-border-radius: 8; -fx-border-width: 1;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblSelecaoInfo" text="Selecione uma unidade para agir"
                           style="-fx-font-size: 12; -fx-text-fill: #94A3B8;"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
