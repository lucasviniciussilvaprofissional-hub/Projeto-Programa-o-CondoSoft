<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="comunicacaoRoot" prefHeight="750.0" prefWidth="1200.0"
            style="-fx-background-color: #F7F8FA;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.condominio.controller.comunicacao.ComunicacaoController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="68.0"
              style="-fx-background-color: #1E293B; -fx-padding: 0 48 0 48;">
            <VBox spacing="2">
                <Label text="CondoSoft"
                       style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                <Label text="Comunicação"
                       style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnVoltarInicio"
                    text="🏠 Início"
                    onAction="#voltarInicio"
                    style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-border-color: #334155; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 20;"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="24"
              style="-fx-padding: 40 60 40 60; -fx-background-color: #F7F8FA;">

            <VBox spacing="20" prefWidth="360"
                  style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #E2E8F0; -fx-border-radius: 16; -fx-padding: 30;">

                <Label text="NOVO COMUNICADO"
                       style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>

                <Separator/>

                <VBox spacing="6">
                    <Label text="Título"/>
                    <TextField fx:id="txtTitulo"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Categoria"/>
                    <ComboBox fx:id="cmbCategoria"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Mensagem"/>
                    <TextArea fx:id="txtMensagem"
                              prefHeight="180"/>
                </VBox>

                <Button fx:id="btnEnviar"
                        text="Enviar Comunicado"
                        onAction="#enviarComunicado"
                        maxWidth="Infinity"
                        style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 10;"/>
            </VBox>

            <VBox spacing="0"
                  HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #E2E8F0; -fx-border-radius: 16;">

                <HBox spacing="12"
                      alignment="CENTER_LEFT"
                      style="-fx-padding: 20;">

                    <Label text="Mensagens"
                           style="-fx-font-size: 16; -fx-font-weight: bold;"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <ComboBox fx:id="cmbFiltro"
                              promptText="Filtrar"
                              onAction="#filtrarMensagens"
                              prefWidth="150"/>

                    <TextField fx:id="txtBusca"
                               promptText="Pesquisar"/>
                </HBox>

                <TableView fx:id="tabelaMensagens"
                           VBox.vgrow="ALWAYS">

                    <columns>
                        <TableColumn fx:id="colTitulo" text="Título" prefWidth="250"/>
                        <TableColumn fx:id="colCategoria" text="Categoria" prefWidth="180"/>
                        <TableColumn fx:id="colData" text="Data" prefWidth="150"/>
                        <TableColumn fx:id="colAutor" text="Autor" prefWidth="180"/>
                    </columns>

                </TableView>
            </VBox>

        </HBox>
    </center>

</BorderPane>