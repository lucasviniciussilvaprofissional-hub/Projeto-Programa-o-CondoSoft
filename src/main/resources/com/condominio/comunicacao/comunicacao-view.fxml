<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="comunicacaoRoot" prefHeight="750.0" prefWidth="1200.0"
            style="-fx-background-color: #F7F8FA;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.condominio.controller.comunicacao.ComunicacaoController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="68.0"
              style="-fx-background-color: #1E293B; -fx-padding: 0 48 0 48;">
            <VBox alignment="CENTER_LEFT" spacing="2.0">
                <Label text="CondoSoft"
                       style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                <Label text="Comunicação"
                       style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnVoltarHome"
                    text="? Início"
                    onAction="#voltarHome"
                    style="-fx-background-color: transparent; -fx-text-fill: #94A3B8;
                           -fx-border-color: #334155; -fx-border-radius: 8;
                           -fx-background-radius: 8; -fx-padding: 8 20;"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="24.0"
              style="-fx-background-color: #F7F8FA; -fx-padding: 40 60 40 60;">

            <!-- Formulário -->

            <VBox spacing="22.0"
                  prefWidth="400.0"
                  style="-fx-background-color: white; -fx-background-radius: 16;
                         -fx-border-color: #E2E8F0; -fx-border-radius: 16;
                         -fx-padding: 32;">

                <VBox spacing="4.0">
                    <Label text="NOVO COMUNICADO"
                           style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                    <Label text="Enviar Mensagem"
                           style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                </VBox>

                <Separator/>

                <VBox spacing="6.0">
                    <Label text="Título"/>
                    <TextField fx:id="txtTitulo"
                               promptText="Digite o título"/>
                </VBox>

                <VBox spacing="6.0">
                    <Label text="Categoria"/>
                    <ComboBox fx:id="cmbCategoria"
                              promptText="Selecione"/>
                </VBox>

                <VBox spacing="6.0">
                    <Label text="Destinatário"/>
                    <ComboBox fx:id="cmbDestinatario"
                              promptText="Todos os moradores"/>
                </VBox>

                <VBox spacing="6.0">
                    <Label text="Mensagem"/>
                    <TextArea fx:id="txtMensagem"
                              prefHeight="220.0"
                              wrapText="true"
                              promptText="Digite a mensagem..."/>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <HBox spacing="12.0">
                    <Button fx:id="btnNovoComunicado"
                            text="Limpar"
                            onAction="#novoComunicado"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #F1F5F9;"/>

                    <Button fx:id="btnEnviar"
                            text="Enviar"
                            onAction="#enviarComunicado"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #2563EB;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;"/>
                </HBox>

            </VBox>

            <!-- Conteúdo -->

            <VBox spacing="24.0"
                  HBox.hgrow="ALWAYS">

                <!-- KPIs -->

                <GridPane hgap="16.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.33"/>
                        <ColumnConstraints percentWidth="33.33"/>
                        <ColumnConstraints percentWidth="33.33"/>
                    </columnConstraints>

                    <rowConstraints>
                        <RowConstraints minHeight="90.0"/>
                    </rowConstraints>

                    <VBox GridPane.columnIndex="0"
                          spacing="6.0"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 12;
                                 -fx-padding: 20;">
                        <Label text="COMUNICADOS"/>
                        <Label fx:id="lblComunicados"
                               text="0"
                               style="-fx-font-size: 22;
                                      -fx-font-weight: bold;"/>
                    </VBox>

                    <VBox GridPane.columnIndex="1"
                          spacing="6.0"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 12;
                                 -fx-padding: 20;">
                        <Label text="LIDOS"/>
                        <Label fx:id="lblLidos"
                               text="0"
                               style="-fx-font-size: 22;
                                      -fx-font-weight: bold;"/>
                    </VBox>

                    <VBox GridPane.columnIndex="2"
                          spacing="6.0"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 12;
                                 -fx-padding: 20;">
                        <Label text="AVISOS ATIVOS"/>
                        <Label fx:id="lblAvisosAtivos"
                               text="0"
                               style="-fx-font-size: 22;
                                      -fx-font-weight: bold;"/>
                    </VBox>
                </GridPane>

                <!-- Tabela -->

                <VBox spacing="0.0"
                      HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white;
                             -fx-background-radius: 16;
                             -fx-border-color: #E2E8F0;
                             -fx-border-radius: 16;">

                    <HBox alignment="CENTER_LEFT"
                          style="-fx-padding: 20 24;">
                        <Label text="Histórico de Comunicados"
                               style="-fx-font-size: 16;
                                      -fx-font-weight: bold;"/>
                    </HBox>

                    <TableView fx:id="tabelaComunicados"
                               VBox.vgrow="ALWAYS">

                        <columns>

                            <TableColumn fx:id="colTitulo"
                                         text="Título"
                                         prefWidth="220.0"/>

                            <TableColumn fx:id="colCategoria"
                                         text="Categoria"
                                         prefWidth="140.0"/>

                            <TableColumn fx:id="colDestinatario"
                                         text="Destinatário"
                                         prefWidth="180.0"/>

                            <TableColumn fx:id="colData"
                                         text="Data"
                                         prefWidth="120.0"/>

                            <TableColumn fx:id="colStatus"
                                         text="Status"
                                         prefWidth="120.0"/>

                        </columns>

                    </TableView>

                </VBox>

            </VBox>

        </HBox>
    </center>

</BorderPane>