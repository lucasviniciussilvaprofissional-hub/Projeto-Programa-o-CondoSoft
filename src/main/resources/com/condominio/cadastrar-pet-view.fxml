<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="cadastrarPetRoot"
            prefHeight="750.0" prefWidth="1200.0"
            style="-fx-background-color: #F7F8FA;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.condosoft.controller.CadastrarPetController">

    <!-- ═══════════════════════ HEADER ═══════════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="68.0"
              style="-fx-background-color: #1E293B; -fx-padding: 0 48 0 48;">
            <VBox alignment="CENTER_LEFT" spacing="2.0">
                <Label text="CondoSoft"
                       style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                <Label text="Cadastrar Pet"
                       style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnVoltarPets" text="← Pets"
                    onAction="#voltarPets"
                    style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-font-size: 13;
                           -fx-cursor: hand; -fx-border-color: #334155; -fx-border-radius: 8;
                           -fx-background-radius: 8; -fx-padding: 8 20;"/>
        </HBox>
    </top>

    <!-- ═══════════════════════ CONTEÚDO ═══════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: #F7F8FA; -fx-background-color: #F7F8FA; -fx-border-color: transparent;">
            <VBox spacing="28.0" style="-fx-background-color: #F7F8FA; -fx-padding: 40 60 40 60;">

                <!-- Breadcrumb -->
                <HBox spacing="6.0" alignment="CENTER_LEFT">
                    <Label text="Início" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-cursor: hand;" onMouseClicked="#voltarHome"/>
                    <Label text="›" style="-fx-font-size: 12; -fx-text-fill: #94A3B8;"/>
                    <Label text="Unidades" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-cursor: hand;" onMouseClicked="#voltarUnidades"/>
                    <Label text="›" style="-fx-font-size: 12; -fx-text-fill: #94A3B8;"/>
                    <Label text="Detalhes" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-cursor: hand;" onMouseClicked="#voltarDetalhes"/>
                    <Label text="›" style="-fx-font-size: 12; -fx-text-fill: #94A3B8;"/>
                    <Label text="Pets" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-cursor: hand;" onMouseClicked="#voltarPets"/>
                    <Label text="›" style="-fx-font-size: 12; -fx-text-fill: #94A3B8;"/>
                    <Label text="Cadastrar" style="-fx-font-size: 12; -fx-text-fill: #1E293B;"/>
                </HBox>

                <VBox spacing="6.0">
                    <Label text="Novo Pet"
                           style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                    <HBox spacing="6.0" alignment="CENTER_LEFT">
                        <Label text="Unidade:" style="-fx-font-size: 13; -fx-text-fill: #64748B;"/>
                        <Label fx:id="lblUnidadeContexto" text="Apto 101 – Bloco A"
                               style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #059669;"/>
                    </HBox>
                </VBox>

                <Separator/>

                <!-- ══════════════════════════════
                     SELETOR DE TIPO (TipoPet)
                ══════════════════════════════ -->
                <VBox spacing="12.0">
                    <Label text="TIPO DO PET"
                           style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                    <HBox spacing="12.0">

                        <!-- Cão -->
                        <VBox fx:id="cardCao" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="8.0"
                              onMouseClicked="#selecionarCao"
                              style="-fx-background-color: white; -fx-background-radius: 14;
                                     -fx-border-color: #059669; -fx-border-radius: 14; -fx-border-width: 2;
                                     -fx-padding: 18 16; -fx-cursor: hand;
                                     -fx-effect: dropshadow(gaussian, #05966930, 10, 0, 0, 2);">
                            <Label text="🐶" style="-fx-font-size: 26;"/>
                            <Label text="Cão"
                                   style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #059669;"/>
                        </VBox>

                        <!-- Gato -->
                        <VBox fx:id="cardGato" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="8.0"
                              onMouseClicked="#selecionarGato"
                              style="-fx-background-color: white; -fx-background-radius: 14;
                                     -fx-border-color: #E2E8F0; -fx-border-radius: 14; -fx-border-width: 2;
                                     -fx-padding: 18 16; -fx-cursor: hand;">
                            <Label text="🐱" style="-fx-font-size: 26;"/>
                            <Label text="Gato"
                                   style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                        </VBox>

                        <!-- Pássaro -->
                        <VBox fx:id="cardPassaro" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="8.0"
                              onMouseClicked="#selecionarPassaro"
                              style="-fx-background-color: white; -fx-background-radius: 14;
                                     -fx-border-color: #E2E8F0; -fx-border-radius: 14; -fx-border-width: 2;
                                     -fx-padding: 18 16; -fx-cursor: hand;">
                            <Label text="🐦" style="-fx-font-size: 26;"/>
                            <Label text="Pássaro"
                                   style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                        </VBox>

                        <!-- Roedor -->
                        <VBox fx:id="cardRoedor" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="8.0"
                              onMouseClicked="#selecionarRoedor"
                              style="-fx-background-color: white; -fx-background-radius: 14;
                                     -fx-border-color: #E2E8F0; -fx-border-radius: 14; -fx-border-width: 2;
                                     -fx-padding: 18 16; -fx-cursor: hand;">
                            <Label text="🐹" style="-fx-font-size: 26;"/>
                            <Label text="Roedor"
                                   style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                        </VBox>

                        <!-- Réptil -->
                        <VBox fx:id="cardReptil" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="8.0"
                              onMouseClicked="#selecionarReptil"
                              style="-fx-background-color: white; -fx-background-radius: 14;
                                     -fx-border-color: #E2E8F0; -fx-border-radius: 14; -fx-border-width: 2;
                                     -fx-padding: 18 16; -fx-cursor: hand;">
                            <Label text="🦎" style="-fx-font-size: 26;"/>
                            <Label text="Réptil"
                                   style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                        </VBox>

                        <!-- Outro -->
                        <VBox fx:id="cardOutro" HBox.hgrow="ALWAYS" alignment="CENTER" spacing="8.0"
                              onMouseClicked="#selecionarOutro"
                              style="-fx-background-color: white; -fx-background-radius: 14;
                                     -fx-border-color: #E2E8F0; -fx-border-radius: 14; -fx-border-width: 2;
                                     -fx-padding: 18 16; -fx-cursor: hand;">
                            <Label text="🐾" style="-fx-font-size: 26;"/>
                            <Label text="Outro"
                                   style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                        </VBox>

                    </HBox>
                    <!-- Campo hidden que guarda o enum selecionado -->
                    <TextField fx:id="txtTipoPetHidden" managed="false" visible="false"/>
                </VBox>

                <!-- ══════════════════════════════
                     FORMULÁRIO
                ══════════════════════════════ -->
                <HBox alignment="CENTER">
                    <VBox spacing="28.0" prefWidth="680.0"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #E2E8F0;
                                 -fx-border-radius: 16; -fx-border-width: 1; -fx-padding: 44;
                                 -fx-effect: dropshadow(gaussian, #00000010, 12, 0, 0, 2);">

                        <Label text="DADOS DO PET"
                               style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                        <Separator/>

                        <!-- Campos: nome, tipo (ComboBox fallback), raça, cor -->
                        <GridPane hgap="24.0" vgap="20.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50.0"/>
                                <ColumnConstraints percentWidth="50.0"/>
                            </columnConstraints>

                            <!-- Nome do pet -->
                            <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="6.0">
                                <Label text="Nome do Pet *"
                                       style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                                <TextField fx:id="txtNome" promptText="Ex: Rex, Mimi, Tweety..."
                                           onKeyReleased="#atualizarPreview"
                                           style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8;
                                                  -fx-background-radius: 8; -fx-padding: 12 14; -fx-font-size: 13;"/>
                            </VBox>

                            <!-- Tipo (ComboBox — complementa os cards acima) -->
                            <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="6.0">
                                <Label text="Tipo (TipoPet) *"
                                       style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                                <ComboBox fx:id="cmbTipoPet" maxWidth="Infinity"
                                          onAction="#sincronizarCards"
                                          style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8;
                                                 -fx-background-radius: 8; -fx-padding: 4 8; -fx-font-size: 13;"/>
                                <Label text="Sincronizado com os cards acima"
                                       style="-fx-font-size: 11; -fx-text-fill: #94A3B8;"/>
                            </VBox>

                            <!-- Raça -->
                            <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" spacing="6.0">
                                <Label text="Raça"
                                       style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                                <TextField fx:id="txtRaca" promptText="Ex: Labrador, Persa, SRD..."
                                           onKeyReleased="#atualizarPreview"
                                           style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8;
                                                  -fx-background-radius: 8; -fx-padding: 12 14; -fx-font-size: 13;"/>
                            </VBox>

                            <!-- Cor -->
                            <VBox GridPane.columnIndex="1" GridPane.rowIndex="1" spacing="6.0">
                                <Label text="Cor"
                                       style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                                <TextField fx:id="txtCor" promptText="Ex: Caramelo, Preto e branco..."
                                           onKeyReleased="#atualizarPreview"
                                           style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8;
                                                  -fx-background-radius: 8; -fx-padding: 12 14; -fx-font-size: 13;"/>
                            </VBox>

                            <!-- Unidade (readonly) -->
                            <VBox GridPane.columnIndex="0" GridPane.rowIndex="2" spacing="6.0">
                                <Label text="Unidade"
                                       style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                                <TextField fx:id="txtUnidade" editable="false"
                                           style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8;
                                                  -fx-background-radius: 8; -fx-padding: 12 14; -fx-font-size: 13;
                                                  -fx-text-fill: #64748B;"/>
                                <Label text="Preenchido automaticamente"
                                       style="-fx-font-size: 11; -fx-text-fill: #94A3B8;"/>
                            </VBox>
                        </GridPane>

                        <!-- Preview do pet -->
                        <VBox spacing="8.0">
                            <Label text="PRÉ-VISUALIZAÇÃO"
                                   style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                            <HBox alignment="CENTER_LEFT" spacing="16.0"
                                  style="-fx-background-color: #F8FAFC; -fx-background-radius: 10;
                                         -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-border-width: 1; -fx-padding: 16 20;">
                                <Label fx:id="previewEmoji" text="🐾" style="-fx-font-size: 30;"/>
                                <VBox spacing="4.0">
                                    <Label fx:id="previewNome" text="Nome não preenchido"
                                           style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                                    <HBox spacing="10.0">
                                        <Label fx:id="previewTipo" text="Tipo: —"
                                               style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
                                        <Label text="·" style="-fx-font-size: 12; -fx-text-fill: #CBD5E1;"/>
                                        <Label fx:id="previewRaca" text="Raça: —"
                                               style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
                                        <Label text="·" style="-fx-font-size: 12; -fx-text-fill: #CBD5E1;"/>
                                        <Label fx:id="previewCor" text="Cor: —"
                                               style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
                                    </HBox>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Nota -->
                        <Label text="* Campos obrigatórios"
                               style="-fx-font-size: 11; -fx-text-fill: #94A3B8;"/>

                        <!-- Botões -->
                        <HBox spacing="12.0" alignment="CENTER_RIGHT">
                            <Button fx:id="btnLimpar" text="Limpar"
                                    onAction="#limparFormulario"
                                    style="-fx-background-color: #F1F5F9; -fx-text-fill: #475569; -fx-background-radius: 8;
                                           -fx-padding: 12 28; -fx-font-size: 13; -fx-cursor: hand;
                                           -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-border-width: 1;"/>
                            <Button fx:id="btnSalvarPet" text="Salvar Pet"
                                    onAction="#salvarPet"
                                    style="-fx-background-color: #059669; -fx-text-fill: white; -fx-background-radius: 8;
                                           -fx-padding: 12 32; -fx-font-size: 13; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        </HBox>

                    </VBox>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
