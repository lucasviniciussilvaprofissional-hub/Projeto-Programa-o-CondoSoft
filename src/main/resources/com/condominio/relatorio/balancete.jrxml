<?xml version="1.0" encoding="UTF-8"?>

<jasperReport
        xmlns="http://jasperreports.sourceforge.net/jasperreports"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://jasperreports.sourceforge.net/jasperreports
        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
        name="balancete"
        pageWidth="595"
        pageHeight="842"
        columnWidth="535"
        leftMargin="30"
        rightMargin="30"
        topMargin="30"
        bottomMargin="30">

    <parameter name="PERIODO" class="java.lang.String"/>
    <parameter name="TOTAL_RECEITAS" class="java.lang.String"/>
    <parameter name="TOTAL_DESPESAS" class="java.lang.String"/>
    <parameter name="SALDO_FINAL" class="java.lang.String"/>

    <field name="data" class="java.lang.String"/>
    <field name="descricao" class="java.lang.String"/>
    <field name="valor" class="java.lang.String"/>

    <title>
        <band height="120">

            <staticText>
                <reportElement x="0" y="0" width="535" height="30"/>
                <textElement textAlignment="Center">
                    <font size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[CONDOSOFT]]></text>
            </staticText>

            <textField>
                <reportElement x="0" y="35" width="535" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA["Balancete - " + $P{PERIODO}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="20" y="75" width="150" height="15"/>
                <text><![CDATA[Total Receitas:]]></text>
            </staticText>

            <textField>
                <reportElement x="170" y="75" width="120" height="15"/>
                <textFieldExpression><![CDATA[$P{TOTAL_RECEITAS}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="20" y="95" width="150" height="15"/>
                <text><![CDATA[Total Despesas:]]></text>
            </staticText>

            <textField>
                <reportElement x="170" y="95" width="120" height="15"/>
                <textFieldExpression><![CDATA[$P{TOTAL_DESPESAS}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="320" y="75" width="100" height="15"/>
                <text><![CDATA[Saldo Final:]]></text>
            </staticText>

            <textField>
                <reportElement x="420" y="75" width="100" height="15"/>
                <textFieldExpression><![CDATA[$P{SALDO_FINAL}]]></textFieldExpression>
            </textField>

        </band>
    </title>

    <columnHeader>
        <band height="20">

            <staticText>
                <reportElement x="0" y="0" width="80" height="20"/>
                <text><![CDATA[Data]]></text>
            </staticText>

            <staticText>
                <reportElement x="80" y="0" width="300" height="20"/>
                <text><![CDATA[Descricao]]></text>
            </staticText>

            <staticText>
                <reportElement x="380" y="0" width="155" height="20"/>
                <text><![CDATA[Valor]]></text>
            </staticText>

        </band>
    </columnHeader>

    <detail>
        <band height="20">

            <textField>
                <reportElement x="0" y="0" width="80" height="20"/>
                <textFieldExpression><![CDATA[$F{data}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="80" y="0" width="300" height="20"/>
                <textFieldExpression><![CDATA[$F{descricao}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="380" y="0" width="155" height="20"/>
                <textFieldExpression><![CDATA[$F{valor}]]></textFieldExpression>
            </textField>

        </band>
    </detail>

</jasperReport>