<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="relatoriosRoot" prefHeight="750.0" prefWidth="1200.0"
            style="-fx-background-color: #F7F8FA;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.condominio.controller.RelatoriosController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="68.0"
              style="-fx-background-color: #1E293B; -fx-padding: 0 48 0 48;">
            <VBox alignment="CENTER_LEFT" spacing="2.0">
                <Label text="CondoSoft"
                       style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                <Label text="Relatórios"
                       style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnVoltarHome"
                    text="? Início"
                    onAction="#voltarHome"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #94A3B8;
                           -fx-font-size: 13;
                           -fx-cursor: hand;
                           -fx-border-color: #334155;
                           -fx-border-radius: 8;
                           -fx-background-radius: 8;
                           -fx-padding: 8 20;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: #F7F8FA;
                           -fx-background-color: #F7F8FA;
                           -fx-border-color: transparent;">

            <VBox spacing="32.0"
                  style="-fx-background-color: #F7F8FA;
                         -fx-padding: 48 60 48 60;">

                <!-- Breadcrumb -->
                <HBox spacing="6.0" alignment="CENTER_LEFT">
                    <Label text="Início"
                           onMouseClicked="#voltarHomeMouse"
                           style="-fx-font-size: 12;
                                  -fx-text-fill: #2563EB;
                                  -fx-cursor: hand;"/>

                    <Label text=">"
                           style="-fx-font-size: 12;
                                  -fx-text-fill: #94A3B8;"/>

                    <Label text="Relatórios"
                           style="-fx-font-size: 12;
                                  -fx-text-fill: #1E293B;"/>
                </HBox>

                <!-- Cabeçalho -->
                <VBox spacing="6.0">
                    <Label text="Central de Relatórios"
                           style="-fx-font-size: 26;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #1E293B;"/>

                    <Label text="Acesse relatórios financeiros, reservas e indicadores do condomínio"
                           style="-fx-font-size: 13;
                                  -fx-text-fill: #64748B;"/>
                </VBox>

                <Separator/>

                <!-- KPIs -->
                <GridPane hgap="16.0" vgap="16.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25.0"/>
                        <ColumnConstraints percentWidth="25.0"/>
                        <ColumnConstraints percentWidth="25.0"/>
                        <ColumnConstraints percentWidth="25.0"/>
                    </columnConstraints>

                    <rowConstraints>
                        <RowConstraints minHeight="90.0"/>
                    </rowConstraints>

                    <VBox GridPane.columnIndex="0"
                          spacing="6.0"
                          alignment="CENTER_LEFT"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 12;
                                 -fx-border-color: #E2E8F0;
                                 -fx-border-radius: 12;
                                 -fx-border-width: 1;
                                 -fx-padding: 20 24;">

                        <Label text="ARRECADAÇÃO"
                               style="-fx-font-size: 10;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #94A3B8;"/>

                        <Label fx:id="lblArrecadacao"
                               text="R$ 0,00"
                               style="-fx-font-size: 22;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #059669;"/>
                    </VBox>

                    <VBox GridPane.columnIndex="1"
                          spacing="6.0"
                          alignment="CENTER_LEFT"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 12;
                                 -fx-border-color: #E2E8F0;
                                 -fx-border-radius: 12;
                                 -fx-border-width: 1;
                                 -fx-padding: 20 24;">

                        <Label text="RESERVAS"
                               style="-fx-font-size: 10;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #94A3B8;"/>

                        <Label fx:id="lblReservas"
                               text="0"
                               style="-fx-font-size: 22;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #2563EB;"/>
                    </VBox>

                    <VBox GridPane.columnIndex="2"
                          spacing="6.0"
                          alignment="CENTER_LEFT"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 12;
                                 -fx-border-color: #E2E8F0;
                                 -fx-border-radius: 12;
                                 -fx-border-width: 1;
                                 -fx-padding: 20 24;">

                        <Label text="OCORRÊNCIAS"
                               style="-fx-font-size: 10;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #94A3B8;"/>

                        <Label fx:id="lblOcorrencias"
                               text="0"
                               style="-fx-font-size: 22;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #D97706;"/>
                    </VBox>

                    <VBox GridPane.columnIndex="3"
                          spacing="6.0"
                          alignment="CENTER_LEFT"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 12;
                                 -fx-border-color: #E2E8F0;
                                 -fx-border-radius: 12;
                                 -fx-border-width: 1;
                                 -fx-padding: 20 24;">

                        <Label text="INADIMPLÊNCIA"
                               style="-fx-font-size: 10;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #94A3B8;"/>

                        <Label fx:id="lblInadimplencia"
                               text="R$ 0,00"
                               style="-fx-font-size: 22;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #DC2626;"/>
                    </VBox>
                </GridPane>

                <Label text="MÓDULOS"
                       style="-fx-font-size: 10;
                              -fx-font-weight: bold;
                              -fx-text-fill: #94A3B8;"/>

                <!-- Cards -->
                <GridPane hgap="24.0" vgap="24.0">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.33"/>
                        <ColumnConstraints percentWidth="33.33"/>
                        <ColumnConstraints percentWidth="33.33"/>
                    </columnConstraints>

                    <!-- Balancete -->
                    <VBox GridPane.columnIndex="0"
                          spacing="16.0"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 16;
                                 -fx-border-color: #E2E8F0;
                                 -fx-border-radius: 16;
                                 -fx-border-width: 1;
                                 -fx-padding: 32;">

                        <Label text="📊"
                               style="-fx-font-size: 28;"/>

                        <VBox spacing="8.0">
                            <Label text="Balancete Financeiro"
                                   style="-fx-font-size: 17;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #1E293B;"/>

                            <Label text="Visualize receitas, despesas e saldo do condomínio."
                                   wrapText="true"
                                   style="-fx-font-size: 12;
                                          -fx-text-fill: #64748B;"/>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS"/>

                        <Button text="Abrir Relatório"
                                fx:id="btnBalancete"
                                onAction="#abrirBalancete"
                                maxWidth="Infinity"
                                style="-fx-background-color: #4F46E5;
                                       -fx-text-fill: white;
                                       -fx-background-radius: 10;
                                       -fx-padding: 12 24;
                                       -fx-font-size: 13;
                                       -fx-font-weight: bold;"/>
                    </VBox>

                    <!-- Reservas -->
                    <VBox GridPane.columnIndex="1"
                          spacing="16.0"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 16;
                                 -fx-border-color: #E2E8F0;
                                 -fx-border-radius: 16;
                                 -fx-border-width: 1;
                                 -fx-padding: 32;">

                        <Label text="📅"
                               style="-fx-font-size: 28;"/>

                        <VBox spacing="8.0">
                            <Label text="Relatório de Reservas"
                                   style="-fx-font-size: 17;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #1E293B;"/>

                            <Label text="Visualize utilização das áreas comuns e reservas."
                                   wrapText="true"
                                   style="-fx-font-size: 12;
                                          -fx-text-fill: #64748B;"/>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS"/>

                        <Button text="Abrir Relatório"
                                fx:id="btnReservas"
                                onAction="#abrirReservas"
                                maxWidth="Infinity"
                                style="-fx-background-color: #2563EB;
                                       -fx-text-fill: white;
                                       -fx-background-radius: 10;
                                       -fx-padding: 12 24;
                                       -fx-font-size: 13;
                                       -fx-font-weight: bold;"/>
                    </VBox>

                    <!-- Inadimplência -->
                    <VBox GridPane.columnIndex="2"
                          spacing="16.0"
                          style="-fx-background-color: white;
                                 -fx-background-radius: 16;
                                 -fx-border-color: #E2E8F0;
                                 -fx-border-radius: 16;
                                 -fx-border-width: 1;
                                 -fx-padding: 32;">

                        <Label text="💰"
                               style="-fx-font-size: 28;"/>

                        <VBox spacing="8.0">
                            <Label text="Inadimplência"
                                   style="-fx-font-size: 17;
                                          -fx-font-weight: bold;
                                          -fx-text-fill: #1E293B;"/>

                            <Label text="Acompanhe unidades com pagamentos pendentes."
                                   wrapText="true"
                                   style="-fx-font-size: 12;
                                          -fx-text-fill: #64748B;"/>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS"/>

                        <Button text="Abrir Relatório"
                                fx:id="btnInadimplencia"
                                onAction="#abrirInadimplencia"
                                maxWidth="Infinity"
                                style="-fx-background-color: #DC2626;
                                       -fx-text-fill: white;
                                       -fx-background-radius: 10;
                                       -fx-padding: 12 24;
                                       -fx-font-size: 13;
                                       -fx-font-weight: bold;"/>
                    </VBox>

                </GridPane>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>