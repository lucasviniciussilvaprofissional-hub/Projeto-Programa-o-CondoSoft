<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1200.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.condominio.controller.financeiro.InadimplenciaController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="80.0" style="-fx-background-color: #1E293B; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;" BorderPane.alignment="CENTER">
            <children>
                <VBox alignment="CENTER_LEFT" prefHeight="79.0" prefWidth="388.0">
                    <children>
                        <Label text="CondoSoft" textFill="#94A3B8">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <Label text="Controle de Inadimplência" textFill="white">
                            <font>
                                <Font name="System Bold" size="22.0" />
                            </font>
                        </Label>
                    </children>
                    <HBox.margin>
                        <Insets left="30.0" />
                    </HBox.margin>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#voltarHome" style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold;" text="Voltar ao Início">
                    <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                    </padding>
                    <HBox.margin>
                        <Insets right="30.0" />
                    </HBox.margin>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>
            </children>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;">
            <content>
                <VBox spacing="24.0" style="-fx-padding: 30;">
                    <children>

                        <HBox spacing="20.0">
                            <children>
                                <VBox prefHeight="100.0" prefWidth="300.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-width: 1;">
                                    <children>
                                        <Label text="VALOR TOTAL EM ATRASO" textFill="#64748B">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                            <VBox.margin>
                                                <Insets left="20.0" top="20.0" />
                                            </VBox.margin>
                                        </Label>
                                        <Label text="R$ 0,00" textFill="#DC2626">
                                            <font>
                                                <Font name="System Bold" size="24.0" />
                                            </font>
                                            <VBox.margin>
                                                <Insets left="20.0" top="5.0" />
                                            </VBox.margin>
                                        </Label>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <Label text="Relatório de Cotas Pendentes" textFill="#1E293B">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>

                        <TableView fx:id="tvInadimplencia" prefHeight="400.0" style="-fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12;">
                            <columns>
                                <TableColumn prefWidth="120.0" text="Bloco / Unidade" />
                                <TableColumn prefWidth="250.0" text="Responsável" />
                                <TableColumn prefWidth="150.0" text="Vencimento" />
                                <TableColumn prefWidth="150.0" text="Dias em Atraso" />
                                <TableColumn prefWidth="150.0" text="Valor Original" />
                                <TableColumn prefWidth="150.0" text="Juros / Multa" />
                                <TableColumn prefWidth="150.0" text="Total Atualizado" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>