<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="pagamentosRoot" prefHeight="750.0" prefWidth="1200.0"
            style="-fx-background-color: #F7F8FA;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.condominio.controller.financeiro.PagamentosController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="68.0"
              style="-fx-background-color: #1E293B; -fx-padding: 0 48 0 48;">
            <VBox alignment="CENTER_LEFT" spacing="2.0">
                <Label text="CondoSoft" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                <Label text="Pagamentos" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnVoltarFinanceiro" text="← Financeiro" onAction="#voltarFinanceiro"
                    style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-font-size: 13;
                           -fx-cursor: hand; -fx-border-color: #334155; -fx-border-radius: 8;
                           -fx-background-radius: 8; -fx-padding: 8 20;"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="0.0" style="-fx-background-color: #F7F8FA; -fx-padding: 40 60 40 60;" VBox.vgrow="ALWAYS">

            <!-- Layout: formulário esquerda + lista direita -->
            <HBox spacing="24.0" HBox.hgrow="ALWAYS">

                <!-- Formulário de Registro de Pagamento -->
                <VBox spacing="22.0" prefWidth="380.0" minWidth="340.0"
                      style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #E2E8F0;
                             -fx-border-radius: 16; -fx-border-width: 1; -fx-padding: 32;
                             -fx-effect: dropshadow(gaussian, #00000010, 12, 0, 0, 2);">

                    <VBox spacing="4.0">
                        <Label text="REGISTRAR PAGAMENTO"
                               style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                        <Label text="Novo Pagamento"
                               style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                    </VBox>
                    <Separator/>

                    <VBox spacing="6.0">
                        <Label text="Unidade *" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                        <ComboBox fx:id="cmbUnidade" promptText="Selecione..." maxWidth="Infinity"
                                  onAction="#carregarBoletosUnidade"
                                  style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8;
                                         -fx-background-radius: 8; -fx-padding: 4 8; -fx-font-size: 13;"/>
                    </VBox>

                    <VBox spacing="6.0">
                        <Label text="Boleto de Referência" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                        <ComboBox fx:id="cmbBoleto" promptText="Selecione o boleto..." maxWidth="Infinity"
                                  onAction="#preencherValorBoleto"
                                  style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8;
                                         -fx-background-radius: 8; -fx-padding: 4 8; -fx-font-size: 13;"/>
                    </VBox>

                    <GridPane hgap="16.0" vgap="14.0">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50.0"/>
                            <ColumnConstraints percentWidth="50.0"/>
                        </columnConstraints>
                        <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="6.0">
                            <Label text="Valor Pago (R$) *" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                            <TextField fx:id="txtValorPago" promptText="Ex: 450.00"
                                       style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8;
                                              -fx-background-radius: 8; -fx-padding: 10 14; -fx-font-size: 13;"/>
                        </VBox>
                        <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="6.0">
                            <Label text="Data do Pagamento *" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                            <DatePicker fx:id="dpDataPagamento" maxWidth="Infinity"
                                        style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8;
                                               -fx-background-radius: 8; -fx-font-size: 13;"/>
                        </VBox>
                        <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" spacing="6.0">
                            <Label text="Forma de Pagamento" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                            <ComboBox fx:id="cmbFormaPagamento" promptText="Selecione..." maxWidth="Infinity"
                                      style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8;
                                             -fx-background-radius: 8; -fx-padding: 4 8; -fx-font-size: 13;"/>
                        </VBox>
                        <VBox GridPane.columnIndex="1" GridPane.rowIndex="1" spacing="6.0">
                            <Label text="Comprovante / Nº" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                            <TextField fx:id="txtComprovante" promptText="Nº ou referência"
                                       style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8;
                                              -fx-background-radius: 8; -fx-padding: 10 14; -fx-font-size: 13;"/>
                        </VBox>
                    </GridPane>

                    <Region VBox.vgrow="ALWAYS"/>
                    <Button fx:id="btnRegistrarPagamento" text="Registrar Pagamento"
                            onAction="#registrarPagamento" maxWidth="Infinity"
                            style="-fx-background-color: #059669; -fx-text-fill: white; -fx-background-radius: 10;
                                   -fx-padding: 14 24; -fx-font-size: 13; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </VBox>

                <!-- Lista de Pagamentos -->
                <VBox spacing="0.0" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #E2E8F0;
                             -fx-border-radius: 16; -fx-border-width: 1;
                             -fx-effect: dropshadow(gaussian, #00000010, 12, 0, 0, 2);">

                    <!-- Cabeçalho da lista -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0"
                          style="-fx-padding: 24 24 16 24; -fx-border-color: transparent transparent #F1F5F9 transparent; -fx-border-width: 1;">
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label text="Histórico de Pagamentos"
                                   style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                            <Label fx:id="lblTotalPagamentos" text="0 pagamentos registrados"
                                   style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
                        </VBox>
                        <ComboBox fx:id="cmbFiltroMes" promptText="Todos os Meses"
                                  prefWidth="160.0" prefHeight="36.0" onAction="#filtrarPagamentos"
                                  style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8;
                                         -fx-background-radius: 8; -fx-border-width: 1; -fx-font-size: 12;"/>
                        <HBox alignment="CENTER_LEFT" spacing="8.0"
                              style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8;
                                     -fx-background-radius: 8; -fx-border-width: 1; -fx-padding: 0 12;"
                              prefHeight="36.0" prefWidth="200.0">
                            <Label text="🔍" style="-fx-font-size: 12; -fx-text-fill: #94A3B8;"/>
                            <TextField fx:id="txtBuscaPagamento" promptText="Buscar unidade..."
                                       onKeyReleased="#filtrarPagamentos"
                                       style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 12;"
                                       prefWidth="160.0"/>
                        </HBox>
                    </HBox>

                    <TableView fx:id="tabelaPagamentos" VBox.vgrow="ALWAYS"
                               style="-fx-background-color: transparent; -fx-border-color: transparent;
                                      -fx-table-cell-border-color: #F1F5F9; -fx-font-size: 12;">
                        <columns>
                            <TableColumn fx:id="colUnidade" text="Unidade" prefWidth="100.0"/>
                            <TableColumn fx:id="colCompetencia" text="Competência" prefWidth="120.0"/>
                            <TableColumn fx:id="colDataPag" text="Data Pag." prefWidth="110.0" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colValorPago" text="Valor" prefWidth="100.0" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colFormaPag" text="Forma" prefWidth="110.0"/>
                            <TableColumn fx:id="colSituacao" text="Situação" prefWidth="110.0" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colAcoes" text="Ações" prefWidth="130.0" style="-fx-alignment: CENTER;"/>
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="10.0">
                                <Label text="💳" style="-fx-font-size: 32;"/>
                                <Label text="Nenhum pagamento registrado"
                                       style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                            </VBox>
                        </placeholder>
                    </TableView>
                </VBox>
            </HBox>
        </HBox>
    </center>
</BorderPane>
