<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1200.0"
            style="-fx-background-color:#F8FAFC;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.condominio.controller.financeiro.DespesasController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0"
              style="-fx-background-color:#1E293B;">
            <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <Label text="Despesas" textFill="white"><font><Font name="System Bold" size="22.0"/></font></Label>
                <Label text=" Fixas e Extraordinárias" textFill="#94A3B8"/>
                <HBox.margin><Insets left="30.0"/></HBox.margin>
            </VBox>
            <Button text="← Financeiro" onAction="#voltarFinanceiro"
                    style="-fx-background-color:#475569;-fx-text-fill:white;-fx-background-radius:8;-fx-padding:8 18;">
                <HBox.margin><Insets right="30.0"/></HBox.margin>
            </Button>
        </HBox>
    </top>
    <center>
        <HBox spacing="20.0">
            <padding><Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/></padding>

            <!-- FORMULÁRIO -->
            <VBox spacing="12.0" prefWidth="340.0"
                  style="-fx-background-color:white;-fx-background-radius:12;-fx-border-color:#E2E8F0;-fx-padding:20;">
                <Label text="Nova Despesa" textFill="#1E293B"><font><Font name="System Bold" size="16.0"/></font></Label>

                <Label text="Tipo:" textFill="#374151"/>
                <ComboBox fx:id="cmbTipoDespesa" maxWidth="1.7976931348623157E308"
                          onAction="#alternarSecoes"/>

                <Label text="Descrição:" textFill="#374151"/>
                <TextField fx:id="txtDescricao" promptText="Ex.: Energia elétrica"/>

                <Label text="Valor (R$):" textFill="#374151"/>
                <TextField fx:id="txtValor" promptText="Ex.: 1200.00"/>

                <Label text="Vencimento:" textFill="#374151"/>
                <DatePicker fx:id="dpVencimento" maxWidth="1.7976931348623157E308"/>

                <!-- Seção FIXA -->
                <VBox fx:id="secaoFixa" spacing="6.0">
                    <Label text="Periodicidade:" textFill="#374151"/>
                    <TextField fx:id="txtPeriodicidade" promptText="MENSAL ou ANUAL"/>
                </VBox>

                <!-- Seção EXTRAORDINARIA -->
                <VBox fx:id="secaoExtraordinaria" spacing="6.0">
                    <Label text="Motivo:" textFill="#374151"/>
                    <TextField fx:id="txtMotivo" promptText="Ex.: Reforma da piscina"/>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <Button text="Salvar Despesa" maxWidth="1.7976931348623157E308"
                        onAction="#salvarDespesa"
                        style="-fx-background-color:#7C3AED;-fx-text-fill:white;-fx-background-radius:8;-fx-font-weight:bold;-fx-padding:11;"/>
                <Button text="Limpar" maxWidth="1.7976931348623157E308"
                        onAction="#limpar"
                        style="-fx-background-color:#F1F5F9;-fx-text-fill:#374151;-fx-background-radius:8;-fx-padding:8;"/>
            </VBox>

            <!-- TABELA + TOTAIS -->
            <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                <HBox spacing="12.0">
                    <VBox prefWidth="200.0" style="-fx-background-color:white;-fx-background-radius:8;-fx-border-color:#E2E8F0;-fx-padding:12;">
                        <Label text="FIXAS" textFill="#64748B"><font><Font name="System Bold" size="11.0"/></font></Label>
                        <Label fx:id="lblTotalFixas" text="R$ 0,00" textFill="#7C3AED"><font><Font name="System Bold" size="20.0"/></font></Label>
                    </VBox>
                    <VBox prefWidth="200.0" style="-fx-background-color:white;-fx-background-radius:8;-fx-border-color:#E2E8F0;-fx-padding:12;">
                        <Label text="EXTRAORDINÁRIAS" textFill="#64748B"><font><Font name="System Bold" size="11.0"/></font></Label>
                        <Label fx:id="lblTotalExtra" text="R$ 0,00" textFill="#DC2626"><font><Font name="System Bold" size="20.0"/></font></Label>
                    </VBox>
                    <VBox prefWidth="200.0" style="-fx-background-color:white;-fx-background-radius:8;-fx-border-color:#E2E8F0;-fx-padding:12;">
                        <Label text="TOTAL GERAL" textFill="#64748B"><font><Font name="System Bold" size="11.0"/></font></Label>
                        <Label fx:id="lblTotalGeral" text="R$ 0,00" textFill="#1E293B"><font><Font name="System Bold" size="20.0"/></font></Label>
                    </VBox>
                </HBox>

                <HBox spacing="8.0">
                    <Button text="Marcar como Paga" onAction="#marcarPaga"
                            style="-fx-background-color:#059669;-fx-text-fill:white;-fx-background-radius:8;-fx-padding:8 14;"/>
                </HBox>

                <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colTipo"      text="Tipo"       prefWidth="130"/>
                        <TableColumn fx:id="colDescricao" text="Descrição"  prefWidth="260"/>
                        <TableColumn fx:id="colValor"     text="Valor"      prefWidth="110"/>
                        <TableColumn fx:id="colVencimento" text="Vencimento" prefWidth="130"/>
                        <TableColumn fx:id="colStatus"    text="Status"     prefWidth="110"/>
                        <TableColumn fx:id="colExtra"     text="Detalhe"    prefWidth="200"/>
                    </columns>
                    <placeholder><Label text="Nenhuma despesa cadastrada."/></placeholder>
                </TableView>
            </VBox>
        </HBox>
    </center>
</BorderPane>
