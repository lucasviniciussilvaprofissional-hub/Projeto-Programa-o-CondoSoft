<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="500.0"
            prefWidth="700.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.condominio.controller.financeiro.GerarBoletoController">

    <children>

        <Label layoutX="260.0"
               layoutY="20.0"
               text="GERAR BOLETO"
               style="-fx-font-size: 22px; -fx-font-weight: bold;" />

        <Separator layoutX="20.0"
                   layoutY="60.0"
                   prefWidth="660.0"/>

        <!-- Unidade -->

        <Label layoutX="50.0"
               layoutY="90.0"
               text="Unidade:" />

        <ComboBox fx:id="cbUnidade"
                  layoutX="180.0"
                  layoutY="85.0"
                  prefWidth="250.0"/>

        <!-- Informações calculadas -->

        <Label layoutX="50.0"
               layoutY="150.0"
               text="Fração Ideal:"/>

        <Label fx:id="lblFracaoIdeal"
               layoutX="180.0"
               layoutY="150.0"
               text="-"
               style="-fx-font-weight: bold;"/>

        <Label layoutX="50.0"
               layoutY="190.0"
               text="Valor Sugerido:"/>

        <Label fx:id="lblValorSugerido"
               layoutX="180.0"
               layoutY="190.0"
               text="R$ 0,00"
               style="-fx-font-weight: bold;"/>

        <Separator layoutX="50.0"
                   layoutY="230.0"
                   prefWidth="500.0"/>

        <!-- Dados do boleto -->

        <Label layoutX="50.0"
               layoutY="260.0"
               text="Valor do Boleto:"/>

        <TextField fx:id="txtValor"
                   layoutX="180.0"
                   layoutY="255.0"
                   prefWidth="250.0"/>

        <Label layoutX="50.0"
               layoutY="310.0"
               text="Vencimento:"/>

        <DatePicker fx:id="dpVencimento"
                    layoutX="180.0"
                    layoutY="305.0"
                    prefWidth="250.0"/>

        <!-- Botões -->

        <Button fx:id="btnGerar"
                layoutX="100.0"
                layoutY="400.0"
                prefWidth="160.0"
                text="Gerar Boleto"
                onAction="#gerarBoleto"/>

        <Button fx:id="btnGerarTodos"
                layoutX="280.0"
                layoutY="400.0"
                prefWidth="160.0"
                text="Gerar Todos"
                onAction="#gerarTodosBoletos"/>

        <Button fx:id="btnVoltar"
                layoutX="460.0"
                layoutY="400.0"
                prefWidth="160.0"
                text="Voltar"
                onAction="#voltarFinanceiro"/>

    </children>

</AnchorPane>