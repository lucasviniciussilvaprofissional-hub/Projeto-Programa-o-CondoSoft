<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="gerarBoletoRoot" prefHeight="750.0" prefWidth="1200.0"
            style="-fx-background-color: #F7F8FA;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.condominio.controller.financeiro.GerarBoletoController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="68.0"
              style="-fx-background-color: #1E293B; -fx-padding: 0 48 0 48;">
            <VBox alignment="CENTER_LEFT" spacing="2.0">
                <Label text="CondoSoft" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                <Label text="Gerar Boleto" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnVoltarFinanceiro" text="← Financeiro" onAction="#voltarFinanceiro"
                    style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-font-size: 13;
                           -fx-cursor: hand; -fx-border-color: #334155; -fx-border-radius: 8;
                           -fx-background-radius: 8; -fx-padding: 8 20;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: #F7F8FA; -fx-background-color: #F7F8FA; -fx-border-color: transparent;">
            <VBox spacing="28.0" style="-fx-background-color: #F7F8FA; -fx-padding: 40 60 40 60;">

                <HBox spacing="6.0" alignment="CENTER_LEFT">
                    <Label text="Início" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-cursor: hand;" onMouseClicked="#voltarHome"/>
                    <Label text="›" style="-fx-font-size: 12; -fx-text-fill: #94A3B8;"/>
                    <Label text="Financeiro" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-cursor: hand;" onMouseClicked="#voltarFinanceiro"/>
                    <Label text="›" style="-fx-font-size: 12; -fx-text-fill: #94A3B8;"/>
                    <Label text="Gerar Boleto" style="-fx-font-size: 12; -fx-text-fill: #1E293B;"/>
                </HBox>

                <VBox spacing="6.0">
                    <Label text="Emitir Boleto de Cobrança"
                           style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                    <Label text="Preencha os dados para gerar o boleto da unidade"
                           style="-fx-font-size: 13; -fx-text-fill: #64748B;"/>
                </VBox>

                <Separator/>

                <!-- Layout: formulário + preview -->
                <HBox spacing="24.0">

                    <!-- Formulário -->
                    <VBox spacing="24.0" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #E2E8F0;
                                 -fx-border-radius: 16; -fx-border-width: 1; -fx-padding: 36;
                                 -fx-effect: dropshadow(gaussian, #00000010, 12, 0, 0, 2);">

                        <Label text="DADOS DO BOLETO" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                        <Separator/>

                        <GridPane hgap="20.0" vgap="18.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50.0"/>
                                <ColumnConstraints percentWidth="50.0"/>
                            </columnConstraints>

                            <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="6.0">
                                <Label text="Unidade *" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                                <ComboBox fx:id="cmbUnidade" promptText="Selecione a unidade..." maxWidth="Infinity"
                                          onAction="#preencherDadosUnidade"
                                          style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8;
                                                 -fx-background-radius: 8; -fx-padding: 4 8; -fx-font-size: 13;"/>
                            </VBox>

                            <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="6.0">
                                <Label text="Responsável" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                                <TextField fx:id="txtResponsavel" promptText="Nome do responsável"
                                           style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 8;
                                                  -fx-background-radius: 8; -fx-padding: 10 14; -fx-font-size: 13;" editable="false"/>
                            </VBox>

                            <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" spacing="6.0">
                                <Label text="Competência *" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                                <ComboBox fx:id="cmbCompetencia" promptText="Ex: Maio/2026" maxWidth="Infinity"
                                          style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8;
                                                 -fx-background-radius: 8; -fx-padding: 4 8; -fx-font-size: 13;"/>
                            </VBox>

                            <VBox GridPane.columnIndex="1" GridPane.rowIndex="1" spacing="6.0">
                                <Label text="Vencimento *" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                                <DatePicker fx:id="dpVencimento" maxWidth="Infinity"
                                            style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8;
                                                   -fx-background-radius: 8; -fx-font-size: 13;"/>
                            </VBox>

                            <VBox GridPane.columnIndex="0" GridPane.rowIndex="2" spacing="6.0">
                                <Label text="Valor da Taxa (R$) *" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                                <TextField fx:id="txtValorTaxa" promptText="Ex: 450.00"
                                           onKeyReleased="#calcularTotal"
                                           style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8;
                                                  -fx-background-radius: 8; -fx-padding: 10 14; -fx-font-size: 13;"/>
                            </VBox>

                            <VBox GridPane.columnIndex="1" GridPane.rowIndex="2" spacing="6.0">
                                <Label text="Multa / Juros (R$)" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                                <TextField fx:id="txtMultaJuros" promptText="Ex: 0.00"
                                           onKeyReleased="#calcularTotal"
                                           style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8;
                                                  -fx-background-radius: 8; -fx-padding: 10 14; -fx-font-size: 13;"/>
                            </VBox>

                            <VBox GridPane.columnIndex="0" GridPane.rowIndex="3" spacing="6.0">
                                <Label text="Desconto (R$)" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                                <TextField fx:id="txtDesconto" promptText="Ex: 0.00"
                                           onKeyReleased="#calcularTotal"
                                           style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8;
                                                  -fx-background-radius: 8; -fx-padding: 10 14; -fx-font-size: 13;"/>
                            </VBox>

                            <VBox GridPane.columnIndex="1" GridPane.rowIndex="3" spacing="6.0">
                                <Label text="Tipo de Cobrança" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                                <ComboBox fx:id="cmbTipoCobranca" promptText="Selecione..." maxWidth="Infinity"
                                          style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8;
                                                 -fx-background-radius: 8; -fx-padding: 4 8; -fx-font-size: 13;"/>
                            </VBox>
                        </GridPane>

                        <VBox spacing="6.0">
                            <Label text="Descrição / Observação" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                            <TextArea fx:id="txtDescricao" prefHeight="80.0" wrapText="true"
                                      promptText="Descrição que aparecerá no boleto..."
                                      style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8;
                                             -fx-background-radius: 8; -fx-padding: 10 14; -fx-font-size: 13;"/>
                        </VBox>

                        <HBox spacing="12.0" alignment="CENTER_RIGHT">
                            <Button fx:id="btnLimpar" text="Limpar" onAction="#limparFormulario"
                                    style="-fx-background-color: #F1F5F9; -fx-text-fill: #475569; -fx-background-radius: 8;
                                           -fx-padding: 12 28; -fx-font-size: 13; -fx-cursor: hand;
                                           -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-border-width: 1;"/>
                            <Button fx:id="btnGerarBoleto" text="Gerar Boleto" onAction="#gerarBoleto"
                                    style="-fx-background-color: #D97706; -fx-text-fill: white; -fx-background-radius: 8;
                                           -fx-padding: 12 32; -fx-font-size: 13; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>

                    <!-- Preview do Boleto -->
                    <VBox spacing="16.0" prefWidth="320.0" minWidth="280.0"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #E2E8F0;
                                 -fx-border-radius: 16; -fx-border-width: 1; -fx-padding: 28;
                                 -fx-effect: dropshadow(gaussian, #00000010, 12, 0, 0, 2);">
                        <Label text="RESUMO DO BOLETO" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                        <Separator/>

                        <VBox spacing="14.0">
                            <HBox>
                                <Label text="Unidade" style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="previewUnidade" text="—"
                                       style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                            </HBox>
                            <HBox>
                                <Label text="Competência" style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="previewCompetencia" text="—"
                                       style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                            </HBox>
                            <HBox>
                                <Label text="Vencimento" style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="previewVencimento" text="—"
                                       style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                            </HBox>
                        </VBox>

                        <Separator/>

                        <VBox spacing="10.0">
                            <HBox>
                                <Label text="Taxa Condominial" style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="previewTaxa" text="R$ 0,00"
                                       style="-fx-font-size: 12; -fx-text-fill: #1E293B;"/>
                            </HBox>
                            <HBox>
                                <Label text="Multa / Juros" style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="previewMulta" text="R$ 0,00"
                                       style="-fx-font-size: 12; -fx-text-fill: #DC2626;"/>
                            </HBox>
                            <HBox>
                                <Label text="Desconto" style="-fx-font-size: 12; -fx-text-fill: #64748B;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="previewDesconto" text="— R$ 0,00"
                                       style="-fx-font-size: 12; -fx-text-fill: #059669;"/>
                            </HBox>
                        </VBox>

                        <Separator/>

                        <!-- Total -->
                        <HBox alignment="CENTER_LEFT">
                            <Label text="TOTAL" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="previewTotal" text="R$ 0,00"
                                   style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
