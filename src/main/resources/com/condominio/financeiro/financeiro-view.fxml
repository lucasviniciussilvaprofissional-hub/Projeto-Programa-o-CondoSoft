<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1200.0"
            style="-fx-background-color: #F8FAFC;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.condominio.controller.financeiro.FinanceiroController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="80.0"
              style="-fx-background-color: #1E293B;">
            <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <Label text="Gestão Financeira" textFill="white">
                    <font><Font name="System Bold" size="24.0"/></font>
                </Label>
                <Label text="REQ05 · REQ06 · REQ07 — Despesas, Rateio, Pagamentos e Inadimplência"
                       textFill="#94A3B8">
                    <font><Font size="12.0"/></font>
                </Label>
                <HBox.margin><Insets left="30.0"/></HBox.margin>
            </VBox>
            <Button text="Voltar ao Início" onAction="#voltarHome"
                    style="-fx-background-color:#EF4444;-fx-text-fill:white;-fx-background-radius:8;-fx-font-weight:bold;-fx-padding:10 20;">
                <HBox.margin><Insets right="30.0"/></HBox.margin>
            </Button>
        </HBox>
    </top>

    <center>
        <VBox spacing="24.0">
            <padding><Insets top="28.0" right="30.0" bottom="28.0" left="30.0"/></padding>

            <!-- DASHBOARD -->
            <HBox spacing="16.0">
                <VBox prefWidth="220.0" style="-fx-background-color:white;-fx-background-radius:8;-fx-border-color:#E2E8F0;-fx-padding:15;">
                    <Label text="ARRECADADO (MÊS)" textFill="#64748B"><font><Font name="System Bold" size="11.0"/></font></Label>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label fx:id="lblArrecadado" text="R$ 0,00" textFill="#10B981"><font><Font name="System Bold" size="22.0"/></font></Label>
                </VBox>
                <VBox prefWidth="220.0" style="-fx-background-color:white;-fx-background-radius:8;-fx-border-color:#E2E8F0;-fx-padding:15;">
                    <Label text="INADIMPLÊNCIA" textFill="#64748B"><font><Font name="System Bold" size="11.0"/></font></Label>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label fx:id="lblInadimplencia" text="R$ 0,00" textFill="#EF4444"><font><Font name="System Bold" size="22.0"/></font></Label>
                </VBox>
                <VBox prefWidth="220.0" style="-fx-background-color:white;-fx-background-radius:8;-fx-border-color:#E2E8F0;-fx-padding:15;">
                    <Label text="BOLETOS ABERTOS" textFill="#64748B"><font><Font name="System Bold" size="11.0"/></font></Label>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label fx:id="lblBoletosAbertos" text="0" textFill="#F59E0B"><font><Font name="System Bold" size="22.0"/></font></Label>
                </VBox>
            </HBox>

            <Label text="Módulos Financeiros" textFill="#1E293B"><font><Font name="System Bold" size="16.0"/></font></Label>

            <HBox spacing="16.0">
                <!-- REQ05 Despesas -->
                <VBox prefWidth="215.0" style="-fx-background-color:white;-fx-background-radius:12;-fx-border-color:#E2E8F0;-fx-padding:18;">
                    <Label text="Despesas" textFill="#1E293B"><font><Font name="System Bold" size="16.0"/></font></Label>
                    <Label text="Registre despesas Fixas e Extraordinárias com herança." textFill="#64748B" wrapText="true" prefHeight="50.0"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Button maxWidth="1.7976931348623157E308" text="Gerenciar Despesas"
                            onAction="#abrirDespesas"
                            style="-fx-background-color:#7C3AED;-fx-text-fill:white;-fx-background-radius:8;-fx-font-weight:bold;-fx-padding:11;"/>
                </VBox>
                <!-- REQ06 Rateio -->
                <VBox prefWidth="215.0" style="-fx-background-color:white;-fx-background-radius:12;-fx-border-color:#E2E8F0;-fx-padding:18;">
                    <Label text="Rateio" textFill="#1E293B"><font><Font name="System Bold" size="16.0"/></font></Label>
                    <Label text="Calcule o rateio mensal por fração ideal de cada unidade." textFill="#64748B" wrapText="true" prefHeight="50.0"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Button maxWidth="1.7976931348623157E308" text="Calcular Rateio"
                            onAction="#abrirRateio"
                            style="-fx-background-color:#0891B2;-fx-text-fill:white;-fx-background-radius:8;-fx-font-weight:bold;-fx-padding:11;"/>
                </VBox>
                <!-- Gerar Boleto -->
                <VBox prefWidth="215.0" style="-fx-background-color:white;-fx-background-radius:12;-fx-border-color:#E2E8F0;-fx-padding:18;">
                    <Label text="Gerar Boleto" textFill="#1E293B"><font><Font name="System Bold" size="16.0"/></font></Label>
                    <Label text="Gere boletos para unidades com vencimento personalizado." textFill="#64748B" wrapText="true" prefHeight="50.0"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Button maxWidth="1.7976931348623157E308" text="Gerar Boleto"
                            onAction="#abrirGerarBoleto"
                            style="-fx-background-color:#D97706;-fx-text-fill:white;-fx-background-radius:8;-fx-font-weight:bold;-fx-padding:11;"/>
                </VBox>
                <!-- REQ07 Pagamentos -->
                <VBox prefWidth="215.0" style="-fx-background-color:white;-fx-background-radius:12;-fx-border-color:#E2E8F0;-fx-padding:18;">
                    <Label text="Pagamentos" textFill="#1E293B"><font><Font name="System Bold" size="16.0"/></font></Label>
                    <Label text="Registre pagamentos e veja o histórico de cobranças." textFill="#64748B" wrapText="true" prefHeight="50.0"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Button maxWidth="1.7976931348623157E308" text="Gerenciar"
                            onAction="#abrirTelaPagamentos"
                            style="-fx-background-color:#049260;-fx-text-fill:white;-fx-background-radius:8;-fx-font-weight:bold;-fx-padding:11;"/>
                </VBox>
                <!-- Inadimplência -->
                <VBox prefWidth="215.0" style="-fx-background-color:white;-fx-background-radius:12;-fx-border-color:#E2E8F0;-fx-padding:18;">
                    <Label text="Inadimplência" textFill="#1E293B"><font><Font name="System Bold" size="16.0"/></font></Label>
                    <Label text="Histórico de boletos vencidos e unidades em débito." textFill="#64748B" wrapText="true" prefHeight="50.0"/>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Button maxWidth="1.7976931348623157E308" text="Gerenciar"
                            onAction="#abrirInadimplencia"
                            style="-fx-background-color:#DC2626;-fx-text-fill:white;-fx-background-radius:8;-fx-font-weight:bold;-fx-padding:11;"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
