<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1200.0"
            style="-fx-background-color:#F7F8FA;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.condominio.controller.financeiro.BalanceteController">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="68.0"
              style="-fx-background-color:#1E293B;-fx-padding:0 48 0 48;">
            <VBox alignment="CENTER_LEFT" spacing="2.0" HBox.hgrow="ALWAYS">
                <Label text="CondoSoft" style="-fx-font-size:14;-fx-font-weight:bold;-fx-text-fill:#94A3B8;"/>
                <Label text="Balancete Financeiro — REQ14 / REQ15"
                       style="-fx-font-size:20;-fx-font-weight:bold;-fx-text-fill:white;"/>
            </VBox>
            <Button onAction="#voltarRelatorios"
                    text="← Voltar para Relatórios"
                    style="-fx-background-color:transparent;-fx-text-fill:#94A3B8;-fx-font-size:13;-fx-cursor:hand;-fx-border-color:#334155;-fx-border-radius:8;-fx-background-radius:8;-fx-padding:8 20;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background:#F7F8FA;-fx-background-color:#F7F8FA;-fx-border-color:transparent;">
            <VBox spacing="20.0" style="-fx-background-color:#F7F8FA;-fx-padding:28 48 28 48;">

                <!-- PERÍODO -->
                <VBox spacing="14.0"
                      style="-fx-background-color:white;-fx-background-radius:12;-fx-border-color:#E2E8F0;-fx-padding:22;">
                    <Label text="PERÍODO DO BALANCETE"
                           style="-fx-font-size:11;-fx-font-weight:bold;-fx-text-fill:#64748B;"/>
                    <HBox spacing="14.0" alignment="BOTTOM_LEFT">
                        <VBox spacing="6.0">
                            <Label text="Mês" style="-fx-font-size:13;-fx-text-fill:#1E293B;"/>
                            <ComboBox fx:id="cbMes" prefWidth="180.0" style="-fx-background-radius:6;"/>
                        </VBox>
                        <VBox spacing="6.0">
                            <Label text="Ano" style="-fx-font-size:13;-fx-text-fill:#1E293B;"/>
                            <ComboBox fx:id="cbAno" prefWidth="120.0" style="-fx-background-radius:6;"/>
                        </VBox>
                        <Button onAction="#gerarBalancete"
                                text="Gerar Balancete"
                                style="-fx-background-color:#4F46E5;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:8;-fx-padding:10 22;-fx-cursor:hand;"/>
                        <Button onAction="#exportarPdf"
                                text="📄 Exportar PDF"
                                style="-fx-background-color:#059669;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:8;-fx-padding:10 18;-fx-cursor:hand;"/>
                        <Button onAction="#exportarInadimplentesCSV"
                                text="📊 Exportar CSV Inadimplentes"
                                style="-fx-background-color:#D97706;-fx-text-fill:white;-fx-font-weight:bold;-fx-background-radius:8;-fx-padding:10 18;-fx-cursor:hand;"/>
                    </HBox>
                    <Label fx:id="lblStatus" text="Selecione o período e clique em Gerar Balancete."
                           style="-fx-font-size:12;-fx-text-fill:#64748B;"/>
                </VBox>

                <!-- CARDS -->
                <GridPane hgap="16.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25.0"/>
                        <ColumnConstraints percentWidth="25.0"/>
                        <ColumnConstraints percentWidth="25.0"/>
                        <ColumnConstraints percentWidth="25.0"/>
                    </columnConstraints>
                    <children>
                        <VBox spacing="6.0" style="-fx-background-color:white;-fx-background-radius:8;-fx-border-color:#E2E8F0;-fx-padding:16;" GridPane.columnIndex="0">
                            <Label text="TOTAL ARRECADADO" style="-fx-font-size:10;-fx-font-weight:bold;-fx-text-fill:#94A3B8;"/>
                            <Label fx:id="lblTotalArrecadado" text="R$ —" style="-fx-font-size:20;-fx-font-weight:bold;-fx-text-fill:#059669;"/>
                        </VBox>
                        <VBox spacing="6.0" style="-fx-background-color:white;-fx-background-radius:8;-fx-border-color:#E2E8F0;-fx-padding:16;" GridPane.columnIndex="1">
                            <Label text="TOTAL DESPESAS" style="-fx-font-size:10;-fx-font-weight:bold;-fx-text-fill:#94A3B8;"/>
                            <Label fx:id="lblTotalDespesas" text="R$ —" style="-fx-font-size:20;-fx-font-weight:bold;-fx-text-fill:#DC2626;"/>
                        </VBox>
                        <VBox spacing="6.0" style="-fx-background-color:white;-fx-background-radius:8;-fx-border-color:#E2E8F0;-fx-padding:16;" GridPane.columnIndex="2">
                            <Label text="SALDO DO PERÍODO" style="-fx-font-size:10;-fx-font-weight:bold;-fx-text-fill:#94A3B8;"/>
                            <Label fx:id="lblSaldo" text="R$ —" style="-fx-font-size:20;-fx-font-weight:bold;-fx-text-fill:#1E293B;"/>
                        </VBox>
                        <VBox spacing="6.0" style="-fx-background-color:white;-fx-background-radius:8;-fx-border-color:#E2E8F0;-fx-padding:16;" GridPane.columnIndex="3">
                            <Label text="INADIMPLÊNCIA TOTAL" style="-fx-font-size:10;-fx-font-weight:bold;-fx-text-fill:#94A3B8;"/>
                            <Label fx:id="lblInadimplencia" text="R$ —" style="-fx-font-size:20;-fx-font-weight:bold;-fx-text-fill:#D97706;"/>
                        </VBox>
                    </children>
                </GridPane>

                <!-- TABELA DE LANÇAMENTOS -->
                <VBox spacing="10.0"
                      style="-fx-background-color:white;-fx-background-radius:12;-fx-border-color:#E2E8F0;-fx-padding:22;">
                    <Label text="Lançamentos do Período"
                           style="-fx-font-size:16;-fx-font-weight:bold;-fx-text-fill:#1E293B;"/>
                    <Label text="Verde = Receita  │  Vermelho = Despesa  │  Clique em 'Exportar PDF' para salvar como arquivo."
                           style="-fx-font-size:11;-fx-text-fill:#94A3B8;"/>

                    <TableView fx:id="tabelaLancamentos" prefHeight="340.0"
                               style="-fx-background-radius:8;-fx-border-color:#E2E8F0;-fx-border-radius:8;">
                        <columns>
                            <TableColumn fx:id="colData"       text="Data"        prefWidth="110"/>
                            <TableColumn fx:id="colDescricao"  text="Descrição"   prefWidth="280"/>
                            <TableColumn fx:id="colCategoria"  text="Categoria"   prefWidth="130"/>
                            <TableColumn fx:id="colTipo"       text="Tipo"        prefWidth="100"/>
                            <TableColumn fx:id="colValor"      text="Valor (R$)"  prefWidth="120"/>
                            <TableColumn fx:id="colSaldoAcum"  text="Saldo Acum." prefWidth="120"/>
                        </columns>
                        <placeholder>
                            <Label text="Gere o balancete para ver os lançamentos do período."/>
                        </placeholder>
                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
