<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="750.0" prefWidth="1200.0" style="-fx-background-color: #F7F8FA;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.condominio.controller.financeiro.BalanceteController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="68.0" style="-fx-background-color: #1E293B; -fx-padding: 0 48 0 48;">
            <VBox alignment="CENTER_LEFT" spacing="2.0">
                <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #94A3B8;" text="CondoSoft" />
                <Label style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;" text="Balancete Financeiro" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#voltarRelatorios" style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-font-size: 13; -fx-cursor: hand; -fx-border-color: #334155; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 20;" text="← Voltar para Relatórios" />
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: #F7F8FA; -fx-background-color: #F7F8FA; -fx-border-color: transparent;">
            <VBox spacing="24.0" style="-fx-background-color: #F7F8FA; -fx-padding: 32 48 32 48;">
                <VBox spacing="16.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-padding: 24;">
                    <Label style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #64748B;" text="PERÍODO DO BALANCETE" />
                    <HBox alignment="BOTTOM_LEFT" spacing="16.0">
                        <VBox spacing="6.0">
                            <Label style="-fx-font-size: 13; -fx-text-fill: #1E293B;" text="Mês" />
                            <ComboBox fx:id="cbMes" prefWidth="180.0" style="-fx-background-radius: 6;" />
                        </VBox>
                        <VBox spacing="6.0">
                            <Label style="-fx-font-size: 13; -fx-text-fill: #1E293B;" text="Ano" />
                            <ComboBox fx:id="cbAno" prefWidth="120.0" style="-fx-background-radius: 6;" />
                        </VBox>
                        <Button onAction="#gerarBalancete" style="-fx-background-color: #4F46E5; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 20; -fx-cursor: hand;" text="Gerar Balancete" />
                    </HBox>
                </VBox>
                <GridPane hgap="16.0" vgap="16.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25.0" />
                        <ColumnConstraints percentWidth="25.0" />
                        <ColumnConstraints percentWidth="25.0" />
                        <ColumnConstraints percentWidth="25.0" />
                    </columnConstraints>
                    <children>
                        <VBox spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-padding: 16;" GridPane.columnIndex="0">
                            <Label style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94A3B8;" text="TOTAL ARRECADADO" />
                            <Label style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #059669;" text="R$ 0,00" />
                        </VBox>
                        <VBox spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-padding: 16;" GridPane.columnIndex="1">
                            <Label style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94A3B8;" text="TOTAL DESPESAS" />
                            <Label style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #DC2626;" text="R$ 0,00" />
                        </VBox>
                        <VBox spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-padding: 16;" GridPane.columnIndex="2">
                            <Label style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94A3B8;" text="SALDO DO PERÍODO" />
                            <Label style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="R$ 0,00" />
                        </VBox>
                        <VBox spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-padding: 16;" GridPane.columnIndex="3">
                            <Label style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94A3B8;" text="INADIMPLÊNCIA" />
                            <Label style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #D97706;" text="R$ 0,00" />
                        </VBox>
                    </children>
                </GridPane>
                <Separator />
                <VBox spacing="12.0">
                    <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Lançamentos do Período" />
                    <TableView prefHeight="350.0" style="-fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;">
                        <columns>
                            <TableColumn prefWidth="120.0" text="Data" />
                            <TableColumn prefWidth="350.0" text="Descrição" />
                            <TableColumn prefWidth="150.0" text="Categoria" />
                            <TableColumn prefWidth="120.0" text="Tipo" />
                            <TableColumn prefWidth="150.0" text="Valor (R$)" />
                            <TableColumn prefWidth="160.0" text="Saldo Acum." />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>