<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1200.0"
            style="-fx-background-color:#F8FAFC;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.condominio.controller.financeiro.RateioController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0"
              style="-fx-background-color:#1E293B;">
            <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <Label text="Rateio Mensal" textFill="white"><font><Font name="System Bold" size="22.0"/></font></Label>
                <Label text="REQ06 — Rateio por fração ideal de cada unidade" textFill="#94A3B8"/>
                <HBox.margin><Insets left="30.0"/></HBox.margin>
            </VBox>
            <Button text="← Financeiro" onAction="#voltarFinanceiro"
                    style="-fx-background-color:#475569;-fx-text-fill:white;-fx-background-radius:8;-fx-padding:8 18;">
                <HBox.margin><Insets right="30.0"/></HBox.margin>
            </Button>
        </HBox>
    </top>
    <center>
        <HBox spacing="20.0">
            <padding><Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/></padding>

            <!-- PAINEL ESQUERDO -->
            <VBox spacing="14.0" prefWidth="330.0"
                  style="-fx-background-color:white;-fx-background-radius:12;-fx-border-color:#E2E8F0;-fx-padding:20;">
                <Label text="Calcular Rateio" textFill="#1E293B"><font><Font name="System Bold" size="16.0"/></font></Label>

                <Label text="Despesa:" textFill="#374151"/>
                <ComboBox fx:id="cmbDespesa" maxWidth="1.7976931348623157E308"
                          onAction="#atualizarInfoDespesa"/>

                <HBox spacing="20.0">
                    <VBox spacing="2.0">
                        <Label text="Total Despesa" textFill="#64748B" style="-fx-font-size:11;"/>
                        <Label fx:id="lblTotalDespesa" text="R$ 0,00" textFill="#1E293B">
                            <font><Font name="System Bold" size="15.0"/></font>
                        </Label>
                    </VBox>
                    <VBox spacing="2.0">
                        <Label text="Unidades" textFill="#64748B" style="-fx-font-size:11;"/>
                        <Label fx:id="lblQtdUnidades" text="0 unidade(s)" textFill="#1E293B">
                            <font><Font name="System Bold" size="15.0"/></font>
                        </Label>
                    </VBox>
                </HBox>

                <Label text="Competência (MM/AAAA):" textFill="#374151"/>
                <TextField fx:id="txtCompetencia" promptText="Ex.: 06/2026"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button text="Calcular e Distribuir Rateio"
                        maxWidth="1.7976931348623157E308"
                        onAction="#calcularRateio"
                        style="-fx-background-color:#0891B2;-fx-text-fill:white;-fx-background-radius:8;-fx-font-weight:bold;-fx-padding:12;"/>

                <Label fx:id="lblResultado" text="" textFill="#059669" wrapText="true"
                       style="-fx-font-weight:bold;"/>

                <Separator/>

                <Label text="Filtrar histórico:" textFill="#374151"/>
                <HBox spacing="8.0">
                    <TextField fx:id="txtCompetencia" promptText="Competência..." HBox.hgrow="ALWAYS"/>
                    <Button text="Filtrar" onAction="#filtrarPorCompetencia"
                            style="-fx-background-color:#E2E8F0;-fx-background-radius:8;-fx-padding:8 12;"/>
                </HBox>
            </VBox>

            <!-- TABELA -->
            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                <Label text="Histórico de Rateios" textFill="#1E293B">
                    <font><Font name="System Bold" size="15.0"/></font>
                </Label>
                <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colUnidade"     text="Unidade"     prefWidth="230"/>
                        <TableColumn fx:id="colFracao"      text="Fração Ideal" prefWidth="130"/>
                        <TableColumn fx:id="colValor"       text="Valor Rateado" prefWidth="150"/>
                        <TableColumn fx:id="colCompetencia" text="Competência"  prefWidth="130"/>
                    </columns>
                    <placeholder><Label text="Nenhum rateio calculado ainda."/></placeholder>
                </TableView>
            </VBox>
        </HBox>
    </center>
</BorderPane>
