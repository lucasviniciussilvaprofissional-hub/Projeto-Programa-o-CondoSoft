<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1200.0" style="-fx-background-color:#F8FAFC;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.condominio.controller.financeiro.RateioController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0" style="-fx-background-color:#1E293B;">
            <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <Label text="Rateio Mensal" textFill="white"><font><Font name="System Bold" size="22.0" /></font></Label>
                <Label text=" Rateio por fração ideal de cada unidade" textFill="#94A3B8" />
                <HBox.margin><Insets left="30.0" /></HBox.margin>
            </VBox>
            <Button onAction="#voltarFinanceiro" style="-fx-background-color:#475569;-fx-text-fill:white;-fx-background-radius:8;-fx-padding:8 18;" text="← Financeiro">
                <HBox.margin><Insets right="30.0" /></HBox.margin>
            </Button>
        </HBox>
    </top>
    <center>
        <HBox spacing="20.0">
            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>

            <!-- PAINEL ESQUERDO -->
            <VBox prefWidth="330.0" spacing="14.0" style="-fx-background-color:white;-fx-background-radius:12;-fx-border-color:#E2E8F0;-fx-padding:20;">
                <Label text="Calcular Rateio" textFill="#1E293B"><font><Font name="System Bold" size="16.0" /></font></Label>

                <Label text="Despesa:" textFill="#374151" />
                <ComboBox fx:id="cmbDespesa" maxWidth="1.7976931348623157E308" onAction="#atualizarInfoDespesa" />

                <HBox spacing="20.0">
                    <VBox spacing="2.0">
                        <Label style="-fx-font-size:11;" text="Total Despesa" textFill="#64748B" />
                        <Label fx:id="lblTotalDespesa" text="R$ 0,00" textFill="#1E293B">
                            <font><Font name="System Bold" size="15.0" /></font>
                        </Label>
                    </VBox>
                    <VBox spacing="2.0">
                        <Label style="-fx-font-size:11;" text="Unidades" textFill="#64748B" />
                        <Label fx:id="lblQtdUnidades" text="0 unidade(s)" textFill="#1E293B">
                            <font><Font name="System Bold" size="15.0" /></font>
                        </Label>
                    </VBox>
                </HBox>

                <Label text="Competência (MM/AAAA):" textFill="#374151" />
                 <TextField fx:id="txtCompetencia" promptText="Competência..." />

                <Region VBox.vgrow="ALWAYS" />

                <Button maxWidth="1.7976931348623157E308" onAction="#calcularRateio" style="-fx-background-color:#0891B2;-fx-text-fill:white;-fx-background-radius:8;-fx-font-weight:bold;-fx-padding:12;" text="Calcular e Distribuir Rateio" />

                <Label fx:id="lblResultado" style="-fx-font-weight:bold;" text="" textFill="#059669" wrapText="true" />

                <Separator />
                <HBox spacing="8.0" />
            </VBox>

            <!-- TABELA -->
            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                <Label text="Histórico de Rateios" textFill="#1E293B">
                    <font><Font name="System Bold" size="15.0" /></font>
                </Label>
                <TableView fx:id="tabela" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colUnidade" prefWidth="230" text="Unidade" />
                        <TableColumn fx:id="colFracao" prefWidth="130" text="Fração Ideal" />
                        <TableColumn fx:id="colValor" prefWidth="150" text="Valor Rateado" />
                        <TableColumn fx:id="colCompetencia" prefWidth="130" text="Competência" />
                    </columns>
                    <placeholder><Label text="Nenhum rateio calculado ainda." /></placeholder>
                </TableView>
            </VBox>
        </HBox>
    </center>
</BorderPane>
