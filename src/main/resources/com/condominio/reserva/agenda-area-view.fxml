<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="agendaAreaRoot" prefHeight="750.0" prefWidth="1200.0"
            style="-fx-background-color: #F7F8FA;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.condominio.controller.reserva.AgendaAreaController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="68.0"
              style="-fx-background-color: #1E293B; -fx-padding: 0 48 0 48;">
            <VBox alignment="CENTER_LEFT" spacing="2.0">
                <Label text="CondoSoft" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                <Label text="Agenda de Áreas" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="12.0" alignment="CENTER_RIGHT">
                <Button fx:id="btnNovaReserva" text="+ Nova Reserva" onAction="#abrirNovaReserva"
                        style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-size: 13;
                               -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 8; -fx-padding: 8 20;"/>
                <Button fx:id="btnVoltarReservas" text="← Reservas" onAction="#voltarReservas"
                        style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-font-size: 13;
                               -fx-cursor: hand; -fx-border-color: #334155; -fx-border-radius: 8;
                               -fx-background-radius: 8; -fx-padding: 8 20;"/>
            </HBox>
        </HBox>
    </top>

    <center>
        <VBox spacing="0.0" style="-fx-background-color: #F7F8FA; -fx-padding: 40 60 40 60;">

            <HBox spacing="6.0" alignment="CENTER_LEFT" style="-fx-padding: 0 0 24 0;">
                <Label text="Início" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-cursor: hand;" onMouseClicked="#voltarHome"/>
                <Label text="›" style="-fx-font-size: 12; -fx-text-fill: #94A3B8;"/>
                <Label text="Reservas" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-cursor: hand;" onMouseClicked="#voltarReservas"/>
                <Label text="›" style="-fx-font-size: 12; -fx-text-fill: #94A3B8;"/>
                <Label text="Agenda" style="-fx-font-size: 12; -fx-text-fill: #1E293B;"/>
            </HBox>

            <!-- Controles de navegação da agenda -->
            <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-padding: 0 0 24 0;">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label text="Agenda de Áreas Comuns"
                           style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                    <Label text="Visualize a ocupação das áreas por dia e horário"
                           style="-fx-font-size: 13; -fx-text-fill: #64748B;"/>
                </VBox>
                <HBox spacing="12.0" alignment="CENTER_RIGHT">
                    <ComboBox fx:id="cmbAreaFiltro" promptText="Todas as Áreas"
                              prefWidth="200.0" prefHeight="40.0" onAction="#carregarAgenda"
                              style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-radius: 8;
                                     -fx-background-radius: 8; -fx-border-width: 1; -fx-font-size: 13;"/>
                    <DatePicker fx:id="dpSemana" prefWidth="180.0" prefHeight="40.0"
                                onAction="#carregarAgenda"
                                style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-radius: 8;
                                       -fx-background-radius: 8; -fx-border-width: 1; -fx-font-size: 13;"/>
                    <Button fx:id="btnAnterior" text="‹" onAction="#semanaAnterior"
                            style="-fx-background-color: white; -fx-text-fill: #374151; -fx-background-radius: 8;
                                   -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-border-width: 1;
                                   -fx-padding: 8 16; -fx-font-size: 16; -fx-cursor: hand;"/>
                    <Button fx:id="btnProximo" text="›" onAction="#proximaSemana"
                            style="-fx-background-color: white; -fx-text-fill: #374151; -fx-background-radius: 8;
                                   -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-border-width: 1;
                                   -fx-padding: 8 16; -fx-font-size: 16; -fx-cursor: hand;"/>
                    <Button fx:id="btnHoje" text="Hoje" onAction="#irParaHoje"
                            style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 8;
                                   -fx-padding: 8 20; -fx-font-size: 13; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </HBox>
            </HBox>

            <!-- Grade da agenda -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background: white; -fx-background-color: white; -fx-border-color: #E2E8F0;
                               -fx-border-radius: 16; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, #00000010, 12, 0, 0, 2);">
                <VBox spacing="0.0">

                    <!-- Cabeçalho dos dias (DOM a SAB) -->
                    <GridPane style="-fx-border-color: transparent transparent #F1F5F9 transparent; -fx-border-width: 1; -fx-padding: 0;">
                        <columnConstraints>
                            <ColumnConstraints prefWidth="100.0" minWidth="100.0"/>
                            <ColumnConstraints percentWidth="14.28"/>
                            <ColumnConstraints percentWidth="14.28"/>
                            <ColumnConstraints percentWidth="14.28"/>
                            <ColumnConstraints percentWidth="14.28"/>
                            <ColumnConstraints percentWidth="14.28"/>
                            <ColumnConstraints percentWidth="14.28"/>
                            <ColumnConstraints percentWidth="14.28"/>
                        </columnConstraints>
                        <!-- Coluna de horário -->
                        <Label GridPane.columnIndex="0" text="Área / Hora"
                               style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #94A3B8;
                                      -fx-padding: 16 12; -fx-alignment: CENTER;"/>
                        <!-- Dias da semana - populados pelo controller -->
                        <Label fx:id="lblDia1" GridPane.columnIndex="1" text="Dom 01"
                               style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;
                                      -fx-padding: 16 8; -fx-alignment: CENTER;"/>
                        <Label fx:id="lblDia2" GridPane.columnIndex="2" text="Seg 02"
                               style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;
                                      -fx-padding: 16 8; -fx-alignment: CENTER;"/>
                        <Label fx:id="lblDia3" GridPane.columnIndex="3" text="Ter 03"
                               style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;
                                      -fx-padding: 16 8; -fx-alignment: CENTER;"/>
                        <Label fx:id="lblDia4" GridPane.columnIndex="4" text="Qua 04"
                               style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;
                                      -fx-padding: 16 8; -fx-alignment: CENTER;"/>
                        <Label fx:id="lblDia5" GridPane.columnIndex="5" text="Qui 05"
                               style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;
                                      -fx-padding: 16 8; -fx-alignment: CENTER; -fx-background-color: #EFF6FF;"/>
                        <Label fx:id="lblDia6" GridPane.columnIndex="6" text="Sex 06"
                               style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;
                                      -fx-padding: 16 8; -fx-alignment: CENTER;"/>
                        <Label fx:id="lblDia7" GridPane.columnIndex="7" text="Sab 07"
                               style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #64748B;
                                      -fx-padding: 16 8; -fx-alignment: CENTER;"/>
                    </GridPane>

                    <!-- Área dinâmica da agenda: populada pelo controller -->
                    <VBox fx:id="vboxAgendaConteudo" spacing="0.0"/>

                    <!-- Legenda -->
                    <HBox spacing="24.0" alignment="CENTER"
                          style="-fx-padding: 16 24; -fx-border-color: #F1F5F9 transparent transparent transparent; -fx-border-width: 1;">
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <Region prefWidth="16.0" prefHeight="16.0"
                                    style="-fx-background-color: #DCFCE7; -fx-background-radius: 4;"/>
                            <Label text="Disponível" style="-fx-font-size: 12; -fx-text-fill: #374151;"/>
                        </HBox>
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <Region prefWidth="16.0" prefHeight="16.0"
                                    style="-fx-background-color: #FEE2E2; -fx-background-radius: 4;"/>
                            <Label text="Reservado" style="-fx-font-size: 12; -fx-text-fill: #374151;"/>
                        </HBox>
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <Region prefWidth="16.0" prefHeight="16.0"
                                    style="-fx-background-color: #F1F5F9; -fx-background-radius: 4;"/>
                            <Label text="Indisponível" style="-fx-font-size: 12; -fx-text-fill: #374151;"/>
                        </HBox>
                    </HBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
