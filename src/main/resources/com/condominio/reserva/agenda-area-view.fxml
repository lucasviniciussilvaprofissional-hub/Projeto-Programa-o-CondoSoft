<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="agendaAreaRoot" prefHeight="750.0" prefWidth="1200.0"
            style="-fx-background-color:#F8FAFC;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.condominio.controller.reserva.AgendaAreaController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0"
              style="-fx-background-color:#1E293B;" spacing="10.0">
            <Button fx:id="btnNovaReserva" text="+ Nova Reserva" onAction="#abrirNovaReserva"
                    style="-fx-background-color:#4F46E5;-fx-text-fill:white;-fx-background-radius:8;-fx-font-weight:bold;-fx-padding:9 14;">
                <HBox.margin><Insets left="20.0"/></HBox.margin>
            </Button>
            <Button fx:id="btnVoltarReservas" text="← Reservas" onAction="#voltarReservas"
                    style="-fx-background-color:transparent;-fx-text-fill:#94A3B8;-fx-border-color:#334155;-fx-border-radius:8;-fx-background-radius:8;-fx-padding:9 14;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER_RIGHT">
                <Label text="Agenda de Áreas Comuns" textFill="white">
                    <font><Font name="System Bold" size="18.0"/></font></Label>
                <Label text="REQ08 — Visualização semanal" textFill="#94A3B8"/>
            </VBox>
            <HBox.margin><Insets right="30.0"/></HBox.margin>
        </HBox>
    </top>

    <center>
        <VBox spacing="14.0">
            <padding><Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/></padding>

            <!-- Controles da agenda -->
            <HBox spacing="10.0" alignment="CENTER_LEFT"
                  style="-fx-background-color:white;-fx-background-radius:10;-fx-border-color:#E2E8F0;-fx-padding:12;">
                <Label text="Área:" textFill="#374151"/>
                <ComboBox fx:id="cmbAreaFiltro" prefWidth="200.0" prefHeight="38.0"
                          onAction="#carregarAgenda"/>
                <Label text="Semana de:" textFill="#374151"/>
                <DatePicker fx:id="dpSemana" prefWidth="160.0" prefHeight="38.0"
                            onAction="#carregarAgenda"/>
                <Button fx:id="btnAnterior" text="‹" onAction="#semanaAnterior"
                        style="-fx-background-color:#E2E8F0;-fx-background-radius:8;-fx-font-size:16;-fx-padding:6 14;"/>
                <Button fx:id="btnProximo"  text="›" onAction="#proximaSemana"
                        style="-fx-background-color:#E2E8F0;-fx-background-radius:8;-fx-font-size:16;-fx-padding:6 14;"/>
                <Button fx:id="btnHoje"     text="Hoje" onAction="#irParaHoje"
                        style="-fx-background-color:#4F46E5;-fx-text-fill:white;-fx-background-radius:8;-fx-padding:8 16;"/>
            </HBox>

            <!-- Cabeçalho de dias -->
            <GridPane hgap="4.0" style="-fx-background-color:white;-fx-background-radius:10;-fx-border-color:#E2E8F0;-fx-padding:10;">
                <columnConstraints>
                    <ColumnConstraints prefWidth="60.0"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <Label text="Hora" textFill="#94A3B8" style="-fx-font-size:11; -fx-font-weight:bold;" GridPane.columnIndex="0"/>
                <Label fx:id="lblDia1" text="Dom" textFill="#1E293B" style="-fx-font-weight:bold;-fx-font-size:12;" GridPane.columnIndex="1"/>
                <Label fx:id="lblDia2" text="Seg" textFill="#1E293B" style="-fx-font-weight:bold;-fx-font-size:12;" GridPane.columnIndex="2"/>
                <Label fx:id="lblDia3" text="Ter" textFill="#1E293B" style="-fx-font-weight:bold;-fx-font-size:12;" GridPane.columnIndex="3"/>
                <Label fx:id="lblDia4" text="Qua" textFill="#1E293B" style="-fx-font-weight:bold;-fx-font-size:12;" GridPane.columnIndex="4"/>
                <Label fx:id="lblDia5" text="Qui" textFill="#1E293B" style="-fx-font-weight:bold;-fx-font-size:12;" GridPane.columnIndex="5"/>
                <Label fx:id="lblDia6" text="Sex" textFill="#1E293B" style="-fx-font-weight:bold;-fx-font-size:12;" GridPane.columnIndex="6"/>
                <Label fx:id="lblDia7" text="Sáb" textFill="#1E293B" style="-fx-font-weight:bold;-fx-font-size:12;" GridPane.columnIndex="7"/>
            </GridPane>

            <!-- Conteúdo dinâmico -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color:transparent;-fx-border-color:transparent;">
                <VBox fx:id="vboxAgendaConteudo" spacing="6.0"
                      style="-fx-padding: 4 0;"/>
            </ScrollPane>

            <Label text="Verde = Ativa  │  Vermelho = Cancelada  │  Azul = Finalizada"
                   style="-fx-font-size:11;-fx-text-fill:#64748B;"/>
        </VBox>
    </center>
</BorderPane>
