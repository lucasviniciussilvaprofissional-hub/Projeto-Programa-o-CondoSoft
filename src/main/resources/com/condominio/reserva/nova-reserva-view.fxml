<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="novaReservaRoot" prefHeight="750.0" prefWidth="1200.0"
            style="-fx-background-color:#F8FAFC;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.condominio.controller.reserva.NovaReservaController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0"
              style="-fx-background-color:#1E293B;">
            <Button fx:id="btnVoltarReservas" text="← Reservas" onAction="#voltarReservas"
                    style="-fx-background-color:transparent;-fx-text-fill:#94A3B8;-fx-font-size:13;-fx-cursor:hand;-fx-border-color:#334155;-fx-border-radius:8;-fx-background-radius:8;-fx-padding:8 18;">
                <HBox.margin><Insets left="20.0"/></HBox.margin>
            </Button>
            <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <Label text="Nova Reserva" textFill="white">
                    <font><Font name="System Bold" size="20.0"/></font></Label>
                <HBox spacing="4.0" alignment="CENTER_LEFT">
                    <Label text="Início" style="-fx-font-size:12;-fx-text-fill:#2563EB;-fx-cursor:hand;" onMouseClicked="#voltarHome"/>
                    <Label text="›" textFill="#94A3B8"/>
                    <Label text="Reservas" style="-fx-font-size:12;-fx-text-fill:#2563EB;-fx-cursor:hand;" onMouseClicked="#voltarReservas"/>
                    <Label text="›" textFill="#94A3B8"/>
                    <Label text="Nova" textFill="white" style="-fx-font-size:12;"/>
                </HBox>
                <HBox.margin><Insets left="16.0"/></HBox.margin>
            </VBox>
        </HBox>
    </top>

    <center>
        <HBox spacing="20.0">
            <padding><Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/></padding>

            <!-- COLUNA ESQUERDA: formulário -->
            <VBox spacing="12.0" prefWidth="500.0"
                  style="-fx-background-color:white;-fx-background-radius:12;-fx-border-color:#E2E8F0;-fx-padding:22;">
                <Label text="Dados da Reserva" textFill="#1E293B">
                    <font><Font name="System Bold" size="16.0"/></font></Label>

                <Label text="Área Comum:" textFill="#374151"/>
                <ComboBox fx:id="cmbAreaComum" promptText="Selecione a área..."
                          maxWidth="1.7976931348623157E308" onAction="#verificarDisponibilidade"/>

                <Label text="Responsável / Unidade:" textFill="#374151"/>
                <ComboBox fx:id="cmbUnidade" promptText="Selecione o morador..."
                          maxWidth="1.7976931348623157E308"/>

                <Label text="Data:" textFill="#374151"/>
                <DatePicker fx:id="dpDataReserva" maxWidth="1.7976931348623157E308"
                            onAction="#verificarDisponibilidade"/>

                <HBox spacing="12.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                        <Label text="Horário Início:" textFill="#374151"/>
                        <ComboBox fx:id="cmbHorarioInicio" maxWidth="1.7976931348623157E308"
                                  onAction="#verificarDisponibilidade"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="4.0">
                        <Label text="Horário Fim:" textFill="#374151"/>
                        <ComboBox fx:id="cmbHorarioFim" maxWidth="1.7976931348623157E308"
                                  onAction="#verificarDisponibilidade"/>
                    </VBox>
                </HBox>

                <Label text="Nº de Pessoas:" textFill="#374151"/>
                <TextField fx:id="txtNumConvidados" promptText="Ex: 10"/>

                <!-- Disponibilidade -->
                <HBox fx:id="hboxDisponibilidade" alignment="CENTER_LEFT" spacing="8.0"
                      style="-fx-background-color:#F0FDF4;-fx-background-radius:8;-fx-padding:10;">
                    <Label fx:id="lblDisponibilidade" text="Verificando..."
                           style="-fx-font-weight:bold; -fx-font-size:13;"/>
                </HBox>

                <TextArea fx:id="txtObservacoes" promptText="Observações (opcional)"
                          prefHeight="70.0" wrapText="true"/>

                <HBox spacing="10.0">
                    <Button fx:id="btnCancelar" text="Cancelar" onAction="#voltarReservas"
                            style="-fx-background-color:#F1F5F9;-fx-text-fill:#374151;-fx-background-radius:8;-fx-padding:10 18;"
                            HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"/>
                    <Button fx:id="btnConfirmarReserva" text="Confirmar Reserva" onAction="#confirmarReserva"
                            style="-fx-background-color:#4F46E5;-fx-text-fill:white;-fx-background-radius:8;-fx-font-weight:bold;-fx-padding:10 18;"
                            HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"/>
                </HBox>

                <Label text="⚠ Regras: sem reservas 22h–8h (silêncio) · adimplência obrigatória · capacidade limitada"
                       style="-fx-font-size:11;-fx-text-fill:#94A3B8;" wrapText="true"/>
            </VBox>

            <!-- COLUNA DIREITA: convidados REQ09 -->
            <VBox spacing="12.0" HBox.hgrow="ALWAYS"
                  style="-fx-background-color:white;-fx-background-radius:12;-fx-border-color:#E2E8F0;-fx-padding:22;">
                <Label text="Lista de Convidados " textFill="#1E293B">
                    <font><Font name="System Bold" size="16.0"/></font></Label>
                <Label text="Para controle de acesso na portaria." textFill="#64748B"/>

                <HBox spacing="8.0">
                    <TextField fx:id="txtNomeConvidado" promptText="Nome do convidado..." HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="txtDocConvidado" promptText="CPF / RG" prefWidth="130.0"/>
                    <Button fx:id="btnAdicionarConvidado" text="+ Adicionar" onAction="#adicionarConvidado"
                            style="-fx-background-color:#4F46E5;-fx-text-fill:white;-fx-background-radius:8;-fx-padding:9 14;"/>
                </HBox>

                <TableView fx:id="tabelaConvidados" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNomeConvidado" text="Nome"  prefWidth="200.0"/>
                        <TableColumn fx:id="colDocConvidado"  text="Doc."  prefWidth="120.0"/>
                        <TableColumn fx:id="colRemoverConvidado" text=""   prefWidth="40.0"/>
                    </columns>
                    <placeholder><Label text="Nenhum convidado adicionado."/></placeholder>
                </TableView>

                <Label fx:id="lblContadorConvidados" text="0 convidados adicionados"
                       style="-fx-font-size:12;-fx-text-fill:#64748B;-fx-font-weight:bold;"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
