<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="reservaRoot" prefHeight="750.0" prefWidth="1200.0"
            style="-fx-background-color: #F7F8FA;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.condominio.controller.reserva.ReservaController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="68.0"
              style="-fx-background-color: #1E293B; -fx-padding: 0 48 0 48;">
            <VBox alignment="CENTER_LEFT" spacing="2.0">
                <Label text="CondoSoft" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                <Label text="Reservas" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnVoltarHome" text="← Início" onAction="#voltarHome"
                    style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-font-size: 13;
                           -fx-cursor: hand; -fx-border-color: #334155; -fx-border-radius: 8;
                           -fx-background-radius: 8; -fx-padding: 8 20;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: #F7F8FA; -fx-background-color: #F7F8FA; -fx-border-color: transparent;">
            <VBox spacing="32.0" style="-fx-background-color: #F7F8FA; -fx-padding: 48 60 48 60;">

                <HBox spacing="6.0" alignment="CENTER_LEFT">
                    <Label text="Início" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-cursor: hand;" onMouseClicked="#voltarHome"/>
                    <Label text="›" style="-fx-font-size: 12; -fx-text-fill: #94A3B8;"/>
                    <Label text="Reservas" style="-fx-font-size: 12; -fx-text-fill: #1E293B;"/>
                </HBox>

                <VBox spacing="6.0">
                    <Label text="Reservas de Áreas Comuns"
                           style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                    <Label text="Gerencie as reservas de áreas comuns do condomínio"
                           style="-fx-font-size: 13; -fx-text-fill: #64748B;"/>
                </VBox>

                <Separator/>
                <Label text="AÇÕES DISPONÍVEIS" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>

                <GridPane hgap="24.0" vgap="24.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.33"/>
                        <ColumnConstraints percentWidth="33.33"/>
                        <ColumnConstraints percentWidth="33.33"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="240.0"/>
                    </rowConstraints>

                    <!-- Nova Reserva -->
                    <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="16.0"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #E2E8F0;
                                 -fx-border-radius: 16; -fx-border-width: 1; -fx-padding: 32;
                                 -fx-effect: dropshadow(gaussian, #00000010, 12, 0, 0, 2);">
                        <VBox alignment="CENTER" prefWidth="56.0" prefHeight="56.0" maxWidth="56.0"
                              style="-fx-background-color: #ECFDF5; -fx-background-radius: 14;">
                            <Label text="📅" style="-fx-font-size: 24;"/>
                        </VBox>
                        <VBox spacing="8.0">
                            <Label text="Nova Reserva"
                                   style="-fx-font-size: 17; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                            <Label text="Agende uma área comum para uma unidade em uma data e horário disponíveis."
                                   style="-fx-font-size: 12; -fx-text-fill: #64748B;" wrapText="true"/>
                        </VBox>
                        <Region VBox.vgrow="ALWAYS"/>
                        <Button fx:id="btnIrNovaReserva" text="Nova Reserva →"
                                onAction="#abrirNovaReserva" maxWidth="Infinity"
                                style="-fx-background-color: #059669; -fx-text-fill: white; -fx-background-radius: 10;
                                       -fx-padding: 12 24; -fx-font-size: 13; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </VBox>

                    <!-- Lista de Reservas -->
                    <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="16.0"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #E2E8F0;
                                 -fx-border-radius: 16; -fx-border-width: 1; -fx-padding: 32;
                                 -fx-effect: dropshadow(gaussian, #00000010, 12, 0, 0, 2);">
                        <VBox alignment="CENTER" prefWidth="56.0" prefHeight="56.0" maxWidth="56.0"
                              style="-fx-background-color: #EFF6FF; -fx-background-radius: 14;">
                            <Label text="📋" style="-fx-font-size: 24;"/>
                        </VBox>
                        <VBox spacing="8.0">
                            <Label text="Lista de Reservas"
                                   style="-fx-font-size: 17; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                            <Label text="Visualize todas as reservas ativas, pendentes e canceladas com opções de gestão."
                                   style="-fx-font-size: 12; -fx-text-fill: #64748B;" wrapText="true"/>
                        </VBox>
                        <Region VBox.vgrow="ALWAYS"/>
                        <Button fx:id="btnIrListaReservas" text="Ver Reservas →"
                                onAction="#abrirListaReservas" maxWidth="Infinity"
                                style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 10;
                                       -fx-padding: 12 24; -fx-font-size: 13; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </VBox>

                    <!-- Agenda de Áreas -->
                    <VBox GridPane.columnIndex="2" GridPane.rowIndex="0" spacing="16.0"
                          style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #E2E8F0;
                                 -fx-border-radius: 16; -fx-border-width: 1; -fx-padding: 32;
                                 -fx-effect: dropshadow(gaussian, #00000010, 12, 0, 0, 2);">
                        <VBox alignment="CENTER" prefWidth="56.0" prefHeight="56.0" maxWidth="56.0"
                              style="-fx-background-color: #F5F3FF; -fx-background-radius: 14;">
                            <Label text="🗓️" style="-fx-font-size: 24;"/>
                        </VBox>
                        <VBox spacing="8.0">
                            <Label text="Agenda de Áreas"
                                   style="-fx-font-size: 17; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                            <Label text="Visualize a ocupação das áreas comuns por data e período de forma visual."
                                   style="-fx-font-size: 12; -fx-text-fill: #64748B;" wrapText="true"/>
                        </VBox>
                        <Region VBox.vgrow="ALWAYS"/>
                        <Button fx:id="btnIrAgenda" text="Ver Agenda →"
                                onAction="#abrirAgendaArea" maxWidth="Infinity"
                                style="-fx-background-color: #7C3AED; -fx-text-fill: white; -fx-background-radius: 10;
                                       -fx-padding: 12 24; -fx-font-size: 13; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </VBox>
                </GridPane>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
