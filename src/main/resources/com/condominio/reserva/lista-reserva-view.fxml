<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1200.0"
            style="-fx-background-color: #F8FAFC;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.condominio.controller.reserva.ListaReservaController">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="72.0"
              style="-fx-background-color:#1E293B;">
            <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <Label text="Reservas de Áreas Comuns" textFill="white">
                    <font><Font name="System Bold" size="22.0"/></font></Label>
                <Label text=" Agenda, Convidados e Taxa de Limpeza"
                       textFill="#94A3B8"/>
                <HBox.margin><Insets left="30.0"/></HBox.margin>
            </VBox>
            <Button text="Voltar ao Início" onAction="#voltarHome"
                    style="-fx-background-color:#EF4444;-fx-text-fill:white;-fx-background-radius:8;-fx-font-weight:bold;-fx-padding:10 18;">
                <HBox.margin><Insets right="30.0"/></HBox.margin>
            </Button>
        </HBox>
    </top>

    <center>
        <VBox spacing="14.0">
            <padding><Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/></padding>

            <!-- Contadores -->
            <HBox spacing="12.0">
                <VBox prefWidth="160.0" style="-fx-background-color:white;-fx-background-radius:8;-fx-border-color:#E2E8F0;-fx-padding:10;">
                    <Label text="ATIVAS" textFill="#64748B"><font><Font name="System Bold" size="11.0"/></font></Label>
                    <Label fx:id="lblTotalAtivas" text="0" textFill="#059669"><font><Font name="System Bold" size="22.0"/></font></Label>
                </VBox>
                <VBox prefWidth="160.0" style="-fx-background-color:white;-fx-background-radius:8;-fx-border-color:#E2E8F0;-fx-padding:10;">
                    <Label text="CANCELADAS" textFill="#64748B"><font><Font name="System Bold" size="11.0"/></font></Label>
                    <Label fx:id="lblTotalCanceladas" text="0" textFill="#EF4444"><font><Font name="System Bold" size="22.0"/></font></Label>
                </VBox>
                <VBox prefWidth="160.0" style="-fx-background-color:white;-fx-background-radius:8;-fx-border-color:#E2E8F0;-fx-padding:10;">
                    <Label text="FINALIZADAS" textFill="#64748B"><font><Font name="System Bold" size="11.0"/></font></Label>
                    <Label fx:id="lblTotalFinalizadas" text="0" textFill="#6366F1"><font><Font name="System Bold" size="22.0"/></font></Label>
                </VBox>
            </HBox>

            <!-- Barra de ações -->
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Label text="Status:" textFill="#374151"/>
                <ComboBox fx:id="cmbFiltroStatus" prefWidth="140.0" onAction="#filtrarReservas"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="+ Nova Reserva"   onAction="#novaReserva"
                        style="-fx-background-color:#4F46E5;-fx-text-fill:white;-fx-background-radius:8;-fx-font-weight:bold;-fx-padding:9 14;"/>
                <Button text="📅 Ver Agenda"    onAction="#abrirAgenda"
                        style="-fx-background-color:#0891B2;-fx-text-fill:white;-fx-background-radius:8;-fx-padding:9 14;"/>
                <Button text="👥 Convidados"    onAction="#verConvidados"
                        style="-fx-background-color:#7C3AED;-fx-text-fill:white;-fx-background-radius:8;-fx-padding:9 14;"/>
                <Button text="✓ Finalizar"      onAction="#finalizarReservaSelecionada"
                        style="-fx-background-color:#059669;-fx-text-fill:white;-fx-background-radius:8;-fx-padding:9 14;"/>
                <Button text="✕ Cancelar"       onAction="#cancelarReservaSelecionada"
                        style="-fx-background-color:#EF4444;-fx-text-fill:white;-fx-background-radius:8;-fx-padding:9 14;"/>
                <Button text="↺"               onAction="#atualizar"
                        style="-fx-background-color:#E2E8F0;-fx-background-radius:8;-fx-padding:9 10;"/>
            </HBox>

            <Label text="Verde = Ativa  │  Vermelho = Cancelada  │  Azul = Finalizada  (clicar em Finalizar lança taxa de limpeza REQ10)"
                   style="-fx-font-size:11; -fx-text-fill:#64748B;"/>

            <TableView fx:id="tvReservas" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId"          text="#"           prefWidth="50"/>
                    <TableColumn fx:id="colArea"        text="Área"        prefWidth="170"/>
                    <TableColumn fx:id="colUnidade"     text="Unidade"     prefWidth="90"/>
                    <TableColumn fx:id="colResponsavel" text="Responsável" prefWidth="180"/>
                    <TableColumn fx:id="colInicio"      text="Início"      prefWidth="110"/>
                    <TableColumn fx:id="colFim"         text="Fim"         prefWidth="110"/>
                    <TableColumn fx:id="colPessoas"     text="Pessoas"     prefWidth="80"/>
                    <TableColumn fx:id="colStatus"      text="Status"      prefWidth="100"/>
                </columns>
                <placeholder><Label text="Nenhuma reserva cadastrada."/></placeholder>
            </TableView>

            <Label fx:id="lblInfo" text="Clique em uma linha para ver detalhes."
                   style="-fx-font-size:12; -fx-text-fill:#64748B;"/>
        </VBox>
    </center>
</BorderPane>
