<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="inadimplentesRoot" prefHeight="750.0" prefWidth="1200.0"
            style="-fx-background-color: #F7F8FA;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.condosoft.controller.InadimplentesRelatorioController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="68.0"
              style="-fx-background-color: #1E293B; -fx-padding: 0 48 0 48;">
            <VBox alignment="CENTER_LEFT" spacing="2.0">
                <Label text="CondoSoft" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                <Label text="Relatório de Inadimplentes" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="12.0" alignment="CENTER_RIGHT">
                <Button fx:id="btnExportarArquivo" text="⬇  Exportar Arquivo" onAction="#exportarArquivo"
                        style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-font-size: 13;
                               -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 8; -fx-padding: 8 20;"/>
                <Button fx:id="btnVoltarRelatorios" text="← Relatórios" onAction="#voltarRelatorios"
                        style="-fx-background-color: transparent; -fx-text-fill: #94A3B8; -fx-font-size: 13;
                               -fx-cursor: hand; -fx-border-color: #334155; -fx-border-radius: 8;
                               -fx-background-radius: 8; -fx-padding: 8 20;"/>
            </HBox>
        </HBox>
    </top>

    <center>
        <VBox spacing="0.0" style="-fx-background-color: #F7F8FA; -fx-padding: 40 60 40 60;">

            <HBox spacing="6.0" alignment="CENTER_LEFT" style="-fx-padding: 0 0 24 0;">
                <Label text="Início" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-cursor: hand;" onMouseClicked="#voltarHome"/>
                <Label text="›" style="-fx-font-size: 12; -fx-text-fill: #94A3B8;"/>
                <Label text="Relatórios" style="-fx-font-size: 12; -fx-text-fill: #2563EB; -fx-cursor: hand;" onMouseClicked="#voltarRelatorios"/>
                <Label text="›" style="-fx-font-size: 12; -fx-text-fill: #94A3B8;"/>
                <Label text="Inadimplentes" style="-fx-font-size: 12; -fx-text-fill: #1E293B;"/>
            </HBox>

            <!-- Filtros e botão de geração -->
            <VBox spacing="16.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #E2E8F0;
                                        -fx-border-radius: 16; -fx-border-width: 1; -fx-padding: 24;
                                        -fx-effect: dropshadow(gaussian, #00000010, 12, 0, 0, 2);
                                        -fx-margin: 0 0 24 0;">
                <Label text="PARÂMETROS DO RELATÓRIO" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                <HBox alignment="CENTER_LEFT" spacing="16.0">
                    <VBox spacing="6.0">
                        <Label text="Competência" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                        <ComboBox fx:id="cmbCompetencia" prefWidth="160.0" prefHeight="40.0"
                                  style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8;
                                         -fx-background-radius: 8; -fx-padding: 4 8; -fx-font-size: 13;"/>
                    </VBox>
                    <VBox spacing="6.0">
                        <Label text="Mínimo de Meses em Atraso" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                        <ComboBox fx:id="cmbMinMeses" prefWidth="180.0" prefHeight="40.0"
                                  style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8;
                                         -fx-background-radius: 8; -fx-padding: 4 8; -fx-font-size: 13;"/>
                    </VBox>
                    <VBox spacing="6.0">
                        <Label text="Bloco" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #374151;"/>
                        <ComboBox fx:id="cmbBloco" prefWidth="130.0" prefHeight="40.0"
                                  style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 8;
                                         -fx-background-radius: 8; -fx-padding: 4 8; -fx-font-size: 13;"/>
                    </VBox>
                    <VBox spacing="6.0">
                        <Label text=" " style="-fx-font-size: 12;"/>
                        <Button fx:id="btnGerarRelatorio" text="Gerar Relatório" onAction="#gerarRelatorio"
                                prefHeight="40.0"
                                style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-background-radius: 8;
                                       -fx-padding: 0 28; -fx-font-size: 13; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblDataGeracao" text=""
                           style="-fx-font-size: 11; -fx-text-fill: #94A3B8;"/>
                </HBox>
            </VBox>

            <!-- KPIs -->
            <GridPane hgap="16.0" style="-fx-padding: 0 0 24 0;">
                <columnConstraints>
                    <ColumnConstraints percentWidth="33.33"/>
                    <ColumnConstraints percentWidth="33.33"/>
                    <ColumnConstraints percentWidth="33.33"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="90.0"/>
                </rowConstraints>
                <VBox GridPane.columnIndex="0" spacing="6.0" alignment="CENTER_LEFT"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E2E8F0;
                             -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 20 24;">
                    <Label text="TOTAL DE INADIMPLENTES" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                    <Label fx:id="lblTotalInadimplentes" text="0 unidades"
                           style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #DC2626;"/>
                </VBox>
                <VBox GridPane.columnIndex="1" spacing="6.0" alignment="CENTER_LEFT"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E2E8F0;
                             -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 20 24;">
                    <Label text="VALOR TOTAL EM ABERTO" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                    <Label fx:id="lblValorTotal" text="R$ 0,00"
                           style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #DC2626;"/>
                </VBox>
                <VBox GridPane.columnIndex="2" spacing="6.0" alignment="CENTER_LEFT"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E2E8F0;
                             -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 20 24;">
                    <Label text="% INADIMPLÊNCIA" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94A3B8;"/>
                    <Label fx:id="lblPercentual" text="0%"
                           style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #D97706;"/>
                </VBox>
            </GridPane>

            <!-- Tabela -->
            <VBox VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #E2E8F0;
                         -fx-border-radius: 16; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, #00000010, 12, 0, 0, 2);">
                <HBox alignment="CENTER_LEFT"
                      style="-fx-padding: 20 24 16 24; -fx-border-color: transparent transparent #F1F5F9 transparent; -fx-border-width: 1;">
                    <Label text="Lista de Inadimplentes"
                           style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnImprimirLista" text="🖨️  Imprimir" onAction="#imprimirLista"
                            style="-fx-background-color: #F1F5F9; -fx-text-fill: #374151; -fx-background-radius: 8;
                                   -fx-padding: 8 18; -fx-font-size: 12; -fx-cursor: hand;
                                   -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-border-width: 1;"/>
                </HBox>
                <TableView fx:id="tabelaInadimplentes" VBox.vgrow="ALWAYS" prefHeight="360.0"
                           style="-fx-background-color: transparent; -fx-border-color: transparent;
                                  -fx-table-cell-border-color: #F1F5F9; -fx-font-size: 13;">
                    <columns>
                        <TableColumn fx:id="colUnidade" text="Unidade" prefWidth="90.0" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colBloco" text="Bloco" prefWidth="80.0" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colMorador" text="Responsável" prefWidth="200.0"/>
                        <TableColumn fx:id="colContato" text="Contato" prefWidth="140.0"/>
                        <TableColumn fx:id="colMesesAtraso" text="Meses" prefWidth="80.0" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colDiasAtraso" text="Dias" prefWidth="70.0" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colValorDevido" text="Valor Devido" prefWidth="130.0" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colSituacao" text="Situação" prefWidth="120.0" style="-fx-alignment: CENTER;"/>
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="10.0">
                            <Label text="📋" style="-fx-font-size: 32;"/>
                            <Label text="Gere o relatório para visualizar os inadimplentes"
                                   style="-fx-font-size: 13; -fx-text-fill: #94A3B8;"/>
                        </VBox>
                    </placeholder>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
